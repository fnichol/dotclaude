#!/usr/bin/env sh
# shellcheck disable=SC3043
set -eu

print_usage() {
  cat <<-EOF
	claude-plugins - Manage Claude Code plugin marketplaces and installations
	
	USAGE:
	    claude-plugins <SUBCOMMAND>
	
	SUBCOMMANDS:
	    install    Sync installed marketplaces and plugins to exact lock file versions
	    update     Install/update marketplaces and capture current plugin versions
	    verify     Verify installed marketplaces and plugins match lock file versions
	    help       Print this help message
	
	EOF
}

main() {
  MARKETPLACES_DIR="${HOME}/.claude/plugins/marketplaces"
  MARKETPLACES_LOCK_FILE="${HOME}/.claude/plugins/.marketplaces.lock.json"
  CACHE_DIR="${HOME}/.claude/plugins/cache"
  PLUGINS_LOCK_FILE="${HOME}/.claude/plugins/.plugins.lock.json"
  KNOWN_MARKETPLACES_FILE="${HOME}/.claude/plugins/known_marketplaces.json"
  INSTALLED_PLUGINS_FILE="${HOME}/.claude/plugins/installed_plugins.json"
  SETTINGS_FILE="${HOME}/.claude/settings.json"

  need_cmd jq
  need_cmd git
  need_cmd claude

  case "${1:-}" in
    install)
      cmd_install
      ;;
    update)
      cmd_update
      ;;
    verify)
      cmd_verify
      ;;
    help | --help | -h)
      print_usage
      exit 0
      ;;
    "")
      die "Missing subcommand. Run 'claude-plugins help' for usage."
      ;;
    *)
      die "Unknown subcommand: $1. Run 'claude-plugins help' for usage."
      ;;
  esac
}

cmd_install() {
  local exit_code=0

  sync_marketplace_lock_file || exit_code=1
  printf "\n"

  install_marketplaces || exit_code=1
  printf "\n"

  sync_plugin_lock_file || exit_code=1
  printf "\n"

  install_plugins || exit_code=1

  print_summary "$exit_code" \
    "Marketplace and plugin sync completed successfully
All installations now match lock file versions." \
    "Some errors occurred during sync
Some installations may not match lock file versions."

  return "$exit_code"
}

cmd_update() {
  local exit_code=0

  update_marketplaces || exit_code=1
  printf "\n"
  update_plugin_versions || exit_code=1

  print_summary "$exit_code" \
    "Marketplace and plugin update completed successfully" \
    "Some errors occurred during update"

  return "$exit_code"
}

cmd_verify() {
  local exit_code=0

  # Detect marketplace lock file drift (but don't fix)
  verify_marketplace_lock_file || exit_code=1
  printf "\n"

  verify_marketplaces || exit_code=1
  printf "\n"

  # Detect plugin lock file drift (but don't fix)
  verify_plugin_lock_file || exit_code=1
  printf "\n"

  verify_plugins || exit_code=1

  print_summary "$exit_code" \
    "All marketplaces and plugins verified successfully" \
    "Some marketplaces or plugins need attention"

  return "$exit_code"
}

# Generic function to detect lock file drift (verify mode - no fix)
# Arguments:
#   $1 - Lock file path
#   $2 - Installed file path
#   $3 - Item type name (e.g., "marketplace", "plugin")
#   $4 - Item type plural (e.g., "marketplaces", "plugins")
#   $5 - JQ expression to extract keys from installed file
verify_lock_file_drift() {
  local lock_file="$1"
  local installed_file="$2"
  local item_type="$3"
  local item_type_plural="$4"
  local jq_keys_expr="$5"

  local section_title
  section_title=$(printf "%s" "$item_type_plural" | tr '[:lower:]' '[:upper:]')
  print_section "CHECKING $section_title LOCK FILE DRIFT"

  if [ ! -f "$lock_file" ]; then
    printf "Error: %s lock file not found: %s\n" "$item_type" "$lock_file" >&2
    return 1
  fi

  if [ ! -f "$installed_file" ]; then
    printf "Warning: %s not found: %s\n" "$installed_file" "$installed_file" >&2
    printf "No %s are currently added to Claude.\n" "$item_type_plural" >&2
    return 0
  fi

  local lock_items installed_items missing_count=0 extra_count=0 exit_code=0

  lock_items=$(jq -r 'keys[]' "$lock_file" | sort)
  installed_items=$(jq -r "$jq_keys_expr" "$installed_file" 2>/dev/null | sort)

  # Check for items in installed file but not in lock file
  local missing item_type_cap
  item_type_cap=$(capitalize "$item_type")
  missing=$(list_diff "$installed_items" "$lock_items")
  for item_name in $missing; do
    printf "DRIFT: %s '%s' is in Claude but not in lock file\n" \
      "$item_type_cap" \
      "$item_name"
    missing_count=$((missing_count + 1))
    exit_code=1
  done

  # Check for items in lock file but not in installed file
  local extra
  extra=$(list_diff "$lock_items" "$installed_items")
  for item_name in $extra; do
    printf "DRIFT: %s '%s' is in lock file but not in Claude\n" \
      "$item_type_cap" \
      "$item_name"
    extra_count=$((extra_count + 1))
    exit_code=1
  done

  if [ "$exit_code" -eq 0 ]; then
    printf "OK: %s lock file is up to date\n" "$item_type_cap"
  else
    printf "\n--- %s Lock File Drift Summary ---\n" "$item_type_cap"
    printf "Missing in lock: %d\n" "$missing_count"
    printf "Extra in lock:   %d\n" "$extra_count"
    printf "\nRun 'claude-plugins install' to fix drift.\n"
  fi

  return "$exit_code"
}

# Detects marketplace lock file drift for verify command (no fix)
verify_marketplace_lock_file() {
  verify_lock_file_drift \
    "$MARKETPLACES_LOCK_FILE" \
    "$KNOWN_MARKETPLACES_FILE" \
    "marketplace" \
    "marketplaces" \
    'keys[]'
}

# Creates a lock entry for a marketplace
# Arguments:
#   $1 - Marketplace name
# Outputs: JSON entry for lock file
create_marketplace_lock_entry() {
  local name="$1"
  local source_obj source_type repo commit="unknown" marketplace_dir updated

  source_obj=$(
    jq -r --arg name "$name" '.[$name].source' "$KNOWN_MARKETPLACES_FILE"
  )
  source_type=$(printf "%s" "$source_obj" | jq -r '.source // "unknown"')
  repo=$(printf "%s" "$source_obj" | jq -r '.repo // "unknown"')
  marketplace_dir=$(
    jq -r \
      --arg name "$name" \
      '.[$name].installLocation' \
      "$KNOWN_MARKETPLACES_FILE"
  )

  if [ -n "$marketplace_dir" ] && [ -d "$marketplace_dir" ]; then
    commit=$(get_git_commit "$marketplace_dir")
    printf "  @ %s\n" "$commit" >&2
  fi

  updated=$(date -u +%Y-%m-%d)

  jq -n \
    --arg source "$source_type" \
    --arg repo "$repo" \
    --arg commit "$commit" \
    --arg updated "$updated" \
    '{source: $source, repo: $repo, commit: $commit, updated: $updated}'
}

# Creates a lock entry for a plugin
# Arguments:
#   $1 - Plugin name
#   $2 - Plugin key (plugin@marketplace format)
# Outputs: JSON entry for lock file
create_plugin_lock_entry() {
  local name="$1"
  local plugin_key="$2"
  local install_path marketplace_name commit="unknown" git_commit_sha updated

  install_path=$(
    jq -r \
      --arg key "$plugin_key" \
      '.plugins[$key][0].installPath' \
      "$INSTALLED_PLUGINS_FILE"
  )
  marketplace_name=$(printf "%s" "$plugin_key" | sed 's/.*@//')
  git_commit_sha=$(
    jq -r \
      --arg key "$plugin_key" \
      '.plugins[$key][0].gitCommitSha // "unknown"' \
      "$INSTALLED_PLUGINS_FILE"
  )

  # Try gitCommitSha from installed_plugins.json first
  if [ "$git_commit_sha" != "unknown" ] && [ "$git_commit_sha" != "null" ]; then
    commit="$git_commit_sha"
    printf "  @ %s\n" "$commit" >&2
  elif [ -n "$install_path" ] && [ -d "$install_path" ]; then
    commit=$(get_git_commit "$install_path")
    printf "  @ %s\n" "$commit" >&2
  else
    printf "  @ %s (local plugin, no git tracking)\n" "$commit" >&2
  fi

  updated=$(date -u +%Y-%m-%d)

  jq -n \
    --arg marketplace "$marketplace_name" \
    --arg commit "$commit" \
    --arg updated "$updated" \
    '{marketplace: $marketplace, commit: $commit, updated: $updated}'
}

# Generic function to sync lock file with installed items
# Arguments:
#   $1 - Lock file path
#   $2 - Installed file path
#   $3 - Item type (e.g., "marketplace", "plugin")
#   $4 - Item type plural
#   $5 - JQ expression to extract item names from installed file
#   $6 - Function name to create lock entry (e.g., "create_marketplace_lock_entry")
sync_lock_file() {
  local lock_file="$1"
  local installed_file="$2"
  local item_type="$3"
  local item_type_plural="$4"
  local jq_keys_expr="$5"
  local create_entry_fn="$6"

  local section_title
  section_title=$(printf "%s" "$item_type_plural" | tr '[:lower:]' '[:upper:]')
  print_section "SYNCING $section_title LOCK FILE"

  if [ ! -f "$lock_file" ]; then
    printf "Error: %s lock file not found: %s\n" "$item_type" "$lock_file" >&2
    return 1
  fi

  if [ ! -f "$installed_file" ]; then
    printf "Warning: %s not found: %s\n" "$installed_file" "$installed_file" >&2
    printf "No %s are currently added to Claude.\n" "$item_type_plural" >&2
    return 0
  fi

  local lock_items installed_items \
    added_count=0 removed_count=0 exit_code=0 needs_update=0

  lock_items=$(jq -r 'keys[]' "$lock_file" | sort)
  installed_items=$(jq -r "$jq_keys_expr" "$installed_file" 2>/dev/null | sort)

  # Add items that are installed but not in lock file
  local missing
  missing=$(list_diff "$installed_items" "$lock_items")
  for item_name in $missing; do
    printf "Adding to lock file: %s\n" "$item_name"

    local entry
    if [ "$item_type" = "plugin" ]; then
      # For plugins, find the full plugin key
      local plugin_key
      plugin_key=$(
        jq -r \
          --arg name "$item_name" \
          '.plugins | keys[] | select(startswith($name + "@"))' \
          "$installed_file" \
          | head -n 1
      )
      if [ -z "$plugin_key" ]; then
        printf "  Warning: Could not find plugin key for %s\n" "$item_name" >&2
        continue
      fi
      entry=$($create_entry_fn "$item_name" "$plugin_key")
    else
      entry=$($create_entry_fn "$item_name")
    fi

    # shellcheck disable=SC2016
    update_json_atomic "$lock_file" \
      --arg name "$item_name" \
      --argjson entry "$entry" \
      '. + {($name): $entry}'
    added_count=$((added_count + 1))
    needs_update=1
  done

  # Remove items that are in lock file but not installed
  local extra
  extra=$(list_diff "$lock_items" "$installed_items")
  for item_name in $extra; do
    printf "Removing from lock file: %s\n" "$item_name"
    # shellcheck disable=SC2016
    update_json_atomic "$lock_file" --arg name "$item_name" 'del(.[$name])'
    removed_count=$((removed_count + 1))
    needs_update=1
  done

  local item_type_cap
  item_type_cap=$(capitalize "$item_type")

  if [ "$needs_update" -eq 0 ]; then
    printf "OK: %s lock file is already up to date\n" "$item_type_cap"
  else
    printf "\n--- %s Lock File Sync Summary ---\n" "$item_type_cap"
    printf "Added:   %d\n" "$added_count"
    printf "Removed: %d\n" "$removed_count"
    printf "\n%s lock file updated!\n" "$item_type_cap"
  fi

  return "$exit_code"
}

# Detects and fixes marketplace lock file drift for install command
sync_marketplace_lock_file() {
  sync_lock_file \
    "$MARKETPLACES_LOCK_FILE" \
    "$KNOWN_MARKETPLACES_FILE" \
    "marketplace" \
    "marketplaces" \
    'keys[]' \
    "create_marketplace_lock_entry"
}

# Detects plugin lock file drift for verify command (no fix)
verify_plugin_lock_file() {
  verify_lock_file_drift \
    "$PLUGINS_LOCK_FILE" \
    "$INSTALLED_PLUGINS_FILE" \
    "plugin" \
    "plugins" \
    '.plugins | keys[] | sub("@.*$"; "") | select(.)'
}

# Detects and fixes plugin lock file drift for install command
sync_plugin_lock_file() {
  print_section "SYNCING PLUGINS LOCK FILE"

  if [ ! -f "$PLUGINS_LOCK_FILE" ]; then
    printf "Error: plugins lock file not found: %s\n" "$PLUGINS_LOCK_FILE" >&2
    return 1
  fi

  if [ ! -f "$INSTALLED_PLUGINS_FILE" ]; then
    printf "Warning: installed_plugins.json not found\n" >&2
    printf "No plugins are currently added to Claude.\n" >&2
    return 0
  fi

  local lock_plugins installed_plugins_list \
    added_count=0 removed_count=0 exit_code=0 needs_update=0

  lock_plugins=$(jq -r 'keys[]' "$PLUGINS_LOCK_FILE" | sort)

  # Get list of enabled plugin names (without marketplace suffix)
  installed_plugins_list=""
  local plugin_keys
  plugin_keys=$(jq -r '.plugins | keys[]' "$INSTALLED_PLUGINS_FILE" 2>/dev/null)

  for plugin_key in $plugin_keys; do
    # Skip plugins that are not enabled in settings.json
    local is_enabled
    is_enabled=$(
      jq -r \
        --arg key "$plugin_key" \
        '.enabledPlugins[$key] // false' \
        "$SETTINGS_FILE" 2>/dev/null
    )
    if [ "$is_enabled" != "true" ]; then
      continue
    fi

    # Extract plugin name (without marketplace)
    local plugin_name
    plugin_name=$(printf "%s" "$plugin_key" | sed 's/@.*//')
    installed_plugins_list="${installed_plugins_list}${plugin_name}
"
  done

  installed_plugins_list=$(printf "%s" "$installed_plugins_list" | sort | uniq)

  # Add plugins that are installed but not in lock file
  local missing
  missing=$(list_diff "$installed_plugins_list" "$lock_plugins")
  for plugin_name in $missing; do
    printf "Adding to lock file: %s\n" "$plugin_name"

    # Find the full plugin key for this plugin name
    local plugin_key
    plugin_key=$(
      jq -r \
        --arg name "$plugin_name" \
        '.plugins | keys[] | select(startswith($name + "@"))' \
        "$INSTALLED_PLUGINS_FILE" \
        | head -n 1
    )
    if [ -z "$plugin_key" ]; then
      printf "  Warning: Could not find plugin key for %s\n" "$plugin_name" >&2
      continue
    fi

    # Check if it's enabled
    local is_enabled
    is_enabled=$(
      jq -r \
        --arg key "$plugin_key" \
        '.enabledPlugins[$key] // false' \
        "$SETTINGS_FILE" 2>/dev/null
    )
    if [ "$is_enabled" != "true" ]; then
      continue
    fi

    local entry
    entry=$(create_plugin_lock_entry "$plugin_name" "$plugin_key")

    # shellcheck disable=SC2016
    update_json_atomic "$PLUGINS_LOCK_FILE" \
      --arg name "$plugin_name" \
      --argjson entry "$entry" \
      '. + {($name): $entry}'
    added_count=$((added_count + 1))
    needs_update=1
  done

  # Remove plugins that are in lock file but not installed
  local extra
  extra=$(list_diff "$lock_plugins" "$installed_plugins_list")
  for plugin_name in $extra; do
    printf "Removing from lock file: %s\n" "$plugin_name"
    # shellcheck disable=SC2016
    update_json_atomic "$PLUGINS_LOCK_FILE" --arg name "$plugin_name" 'del(.[$name])'
    removed_count=$((removed_count + 1))
    needs_update=1
  done

  if [ "$needs_update" -eq 0 ]; then
    printf "OK: Plugin lock file is already up to date\n"
  else
    printf "\n--- Plugin Lock File Sync Summary ---\n"
    printf "Added:   %d\n" "$added_count"
    printf "Removed: %d\n" "$removed_count"
    printf "\nPlugin lock file updated!\n"
  fi

  return "$exit_code"
}

# Syncs marketplaces to lock file versions
install_marketplaces() {
  print_section "SYNCING MARKETPLACES TO LOCK FILE"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" \
      "$MARKETPLACES_LOCK_FILE" >&2
    printf "Run 'claude-plugins update' first to create it.\n" >&2
    return 1
  fi

  local marketplace_synced_count=0
  local marketplace_skipped_count=0
  local marketplace_names
  local exit_code=0

  marketplace_names=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE")

  for marketplace_name in $marketplace_names; do
    local source
    local repo
    local expected_commit

    source=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].source' \
        "$MARKETPLACES_LOCK_FILE"
    )
    repo=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].repo' \
        "$MARKETPLACES_LOCK_FILE"
    )
    expected_commit=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].commit // "unknown"' \
        "$MARKETPLACES_LOCK_FILE"
    )

    if [ "$source" != "github" ]; then
      printf "Warning: Skipping %s - only 'github' source is supported\n" \
        "$marketplace_name" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    if [ -z "$repo" ] || [ "$repo" = "null" ]; then
      printf "Warning: Skipping %s - no repo specified\n" \
        "$marketplace_name" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    if [ "$expected_commit" = "unknown" ] || [ "$expected_commit" = "null" ]; then
      printf "Warning: Skipping %s - no commit specified in lock file\n" \
        "$marketplace_name" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    # Check if marketplace is already installed
    local is_installed
    is_installed=$(
      jq -r \
        --arg name "$marketplace_name" \
        'has($name)' \
        "$KNOWN_MARKETPLACES_FILE" 2>/dev/null \
        || printf "false"
    )

    if [ "$is_installed" = "true" ]; then
      # Marketplace exists, check if it's at the right commit
      local marketplace_dir
      marketplace_dir=$(
        jq -r \
          --arg name "$marketplace_name" \
          '.[$name].installLocation' \
          "$KNOWN_MARKETPLACES_FILE"
      )

      if [ -d "$marketplace_dir" ]; then
        cd "$marketplace_dir"
        local actual_commit
        actual_commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")

        if [ "$actual_commit" = "$expected_commit" ]; then
          printf "Already synced: %s @ %s\n" \
            "$marketplace_name" \
            "$expected_commit"
          cd - >/dev/null 2>&1
          continue
        else
          printf "Syncing: %s\n" "$marketplace_name"
          printf "  From: %s\n" "$actual_commit"
          printf "  To:   %s\n" "$expected_commit"

          git fetch origin >/dev/null 2>&1 || {
            printf "  Warning: Could not fetch from origin\n" >&2
          }

          if ! git reset --hard "$expected_commit" 2>/dev/null; then
            printf "  Error: Could not reset to commit %s\n" \
              "$expected_commit" >&2
            exit_code=1
            cd - >/dev/null 2>&1
            continue
          fi
          marketplace_synced_count=$((marketplace_synced_count + 1))
        fi
        cd - >/dev/null 2>&1
      fi
    else
      # Marketplace not installed, add it via claude CLI
      printf "Installing: %s (from %s)\n" "$marketplace_name" "$repo"

      if ! claude plugin marketplace add "$repo" >/dev/null 2>&1; then
        printf "  Error: Could not add marketplace via 'claude plugin marketplace add'\n" >&2
        exit_code=1
        continue
      fi

      # After adding, reset to the specific commit
      local marketplace_dir
      marketplace_dir=$(
        jq -r \
          --arg name "$marketplace_name" \
          '.[$name].installLocation' \
          "$KNOWN_MARKETPLACES_FILE" 2>/dev/null
      )

      if [ -n "$marketplace_dir" ] && [ -d "$marketplace_dir" ]; then
        cd "$marketplace_dir"
        if ! git reset --hard "$expected_commit" 2>/dev/null; then
          printf "  Error: Could not reset to commit %s\n" \
            "$expected_commit" >&2
          exit_code=1
          cd - >/dev/null 2>&1
          continue
        fi
        cd - >/dev/null 2>&1
        printf "  @ %s\n" "$expected_commit"
        marketplace_synced_count=$((marketplace_synced_count + 1))
      else
        printf "  Error: Could not find installed marketplace directory\n" >&2
        exit_code=1
      fi
    fi
  done

  printf "\n--- Marketplace Sync Summary ---\n"
  printf "Lock file: %s\n" "$MARKETPLACES_LOCK_FILE"
  printf "Synced:  %d\n" "$marketplace_synced_count"
  printf "Skipped: %d\n" "$marketplace_skipped_count"
  printf "\nMarketplace sync complete!\n"

  return "$exit_code"
}

# Syncs plugins to lock file versions
install_plugins() {
  print_section "SYNCING PLUGINS TO LOCK FILE"

  if [ ! -f "$PLUGINS_LOCK_FILE" ]; then
    printf "Error: plugins lock file not found: %s\n" "$PLUGINS_LOCK_FILE" >&2
    printf "Run 'claude-plugins update' first to create it.\n" >&2
    return 1
  fi

  local plugin_synced_count=0
  local plugin_skipped_count=0
  local plugin_names
  local exit_code=0

  plugin_names=$(jq -r 'keys[]' "$PLUGINS_LOCK_FILE")

  for plugin_name in $plugin_names; do
    local marketplace_name
    local expected_commit

    marketplace_name=$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].marketplace' \
        "$PLUGINS_LOCK_FILE"
    )
    expected_commit=$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].commit' \
        "$PLUGINS_LOCK_FILE"
    )

    if [ -z "$marketplace_name" ] || [ "$marketplace_name" = "null" ] || [ "$marketplace_name" = "unknown" ]; then
      printf "Warning: Skipping %s - no marketplace specified\n" \
        "$plugin_name" >&2
      plugin_skipped_count=$((plugin_skipped_count + 1))
      continue
    fi

    if [ "$expected_commit" = "unknown" ] || [ "$expected_commit" = "null" ]; then
      printf "Warning: Skipping %s - no commit specified in lock file\n" \
        "$plugin_name" >&2
      plugin_skipped_count=$((plugin_skipped_count + 1))
      continue
    fi

    # Check if plugin is already installed
    # Search by plugin name across all marketplaces (handles URL vs name
    # mismatch)
    local installed_plugin_key
    installed_plugin_key=$(jq -r --arg name "$plugin_name" '
      .plugins | keys[] | select(startswith($name + "@"))
    ' "$INSTALLED_PLUGINS_FILE" 2>/dev/null | head -n 1)

    local is_installed
    if [ -n "$installed_plugin_key" ]; then
      is_installed="true"
    else
      is_installed="false"
    fi

    if [ "$is_installed" = "true" ]; then
      # Plugin exists, check if it's at the right commit
      local actual_commit
      actual_commit=$(
        jq -r \
          --arg key "$installed_plugin_key" \
          '.plugins[$key][0].gitCommitSha // "unknown"' \
          "$INSTALLED_PLUGINS_FILE"
      )

      if [ "$actual_commit" = "$expected_commit" ]; then
        printf "Already synced: %s @ %s\n" "$plugin_name" "$expected_commit"
        continue
      else
        printf "Syncing: %s\n" "$plugin_name"
        printf "  From: %s\n" "$actual_commit"
        printf "  To:   %s\n" "$expected_commit"

        # Reinstall plugin to get it from marketplace at correct commit
        if ! claude plugin remove "$installed_plugin_key" >/dev/null 2>&1; then
          printf "  Warning: Could not remove plugin\n" >&2
        fi

        local plugin_key="${plugin_name}@${marketplace_name}"
        if ! claude plugin install "$plugin_key" >/dev/null 2>&1; then
          printf "  Error: Could not install plugin via 'claude plugin install'\n" >&2
          exit_code=1
          continue
        fi
        printf "  @ %s\n" "$expected_commit"
        plugin_synced_count=$((plugin_synced_count + 1))
      fi
    else
      # Plugin not installed, install it via claude CLI
      # Construct plugin_key using marketplace_name from lock file
      local plugin_key="${plugin_name}@${marketplace_name}"
      printf "Installing: %s (from %s)\n" "$plugin_name" "$marketplace_name"

      if ! claude plugin install "$plugin_key" >/dev/null 2>&1; then
        printf "  Error: Could not install plugin via 'claude plugin install'\n" >&2
        exit_code=1
        continue
      fi

      # Plugin installed from marketplace at its current commit
      printf "  @ %s\n" "$expected_commit"
      plugin_synced_count=$((plugin_synced_count + 1))
    fi
  done

  printf "\n--- Plugin Sync Summary ---\n"
  printf "Lock file: %s\n" "$PLUGINS_LOCK_FILE"
  printf "Synced:  %d\n" "$plugin_synced_count"
  printf "Skipped: %d\n" "$plugin_skipped_count"
  printf "\nPlugin sync complete!\n"

  return "$exit_code"
}

# Updates marketplaces to latest versions
update_marketplaces() {
  print_section "UPDATING MARKETPLACES"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" \
      "$MARKETPLACES_LOCK_FILE" >&2
    return 1
  fi

  printf "{}\n" >"$MARKETPLACES_LOCK_FILE.tmp"

  local marketplace_names
  marketplace_names=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE")

  for marketplace_name in $marketplace_names; do
    local source
    local repo

    source=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].source' \
        "$MARKETPLACES_LOCK_FILE"
    )
    repo=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].repo' \
        "$MARKETPLACES_LOCK_FILE"
    )

    if [ "$source" != "github" ]; then
      printf "Warning: Skipping %s - only 'github' source is supported\n" \
        "$marketplace_name" >&2
      continue
    fi

    if [ -z "$repo" ] || [ "$repo" = "null" ]; then
      printf "Warning: Skipping %s - no repo specified\n" \
        "$marketplace_name" >&2
      continue
    fi

    # Check if marketplace is already tracked by claude CLI
    local is_known
    is_known=$(
      jq -r \
        --arg name "$marketplace_name" \
        'has($name)' \
        "$KNOWN_MARKETPLACES_FILE" 2>/dev/null \
        || printf "false"
    )

    if [ "$is_known" = "false" ]; then
      printf "Adding: %s (from %s)\n" "$marketplace_name" "$repo"
      if ! claude plugin marketplace add "$repo" >/dev/null 2>&1; then
        printf "  Warning: Could not add marketplace\n" >&2
        continue
      fi
    fi

    printf "Updating: %s\n" "$marketplace_name"
    if ! claude plugin marketplace update "$marketplace_name" >/dev/null 2>&1; then
      printf "  Warning: Could not update marketplace\n" >&2
    fi

    # Get the current commit after update
    local marketplace_dir commit
    marketplace_dir=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].installLocation' \
        "$KNOWN_MARKETPLACES_FILE" 2>/dev/null
    )

    if [ -n "$marketplace_dir" ]; then
      commit=$(get_git_commit "$marketplace_dir")
      printf "  @ %s\n" "$commit"
    else
      commit="unknown"
    fi

    local entry
    entry=$(jq -n \
      --arg source "$source" \
      --arg repo "$repo" \
      --arg commit "$commit" \
      --arg updated "$(date -u +%Y-%m-%d)" \
      '{source: $source, repo: $repo, commit: $commit, updated: $updated}')

    # shellcheck disable=SC2016
    update_json_atomic "$MARKETPLACES_LOCK_FILE.tmp" \
      --arg name "$marketplace_name" \
      --argjson entry "$entry" \
      '. + {($name): $entry}'
  done

  cat "$MARKETPLACES_LOCK_FILE.tmp" >"$MARKETPLACES_LOCK_FILE" \
    && rm "$MARKETPLACES_LOCK_FILE.tmp"

  printf "\n--- Marketplace Update Summary ---\n"
  printf "Lock file: %s\n" "$MARKETPLACES_LOCK_FILE"
  printf "Total marketplaces: %s\n" "$(jq 'length' "$MARKETPLACES_LOCK_FILE")"
  printf "\nMarketplace update complete!\n"

  return 0
}

# Updates plugin versions in lock file
update_plugin_versions() {
  print_section "UPDATING PLUGIN VERSIONS"

  if [ ! -f "$INSTALLED_PLUGINS_FILE" ]; then
    printf "Warning: No plugins installed yet.\n" >&2
    printf "Skipping plugin version update.\n" >&2
    return 0
  fi

  printf "{}\n" >"$PLUGINS_LOCK_FILE.tmp"

  # Iterate through all installed plugins
  local plugin_keys
  plugin_keys=$(jq -r '.plugins | keys[]' "$INSTALLED_PLUGINS_FILE" 2>/dev/null)

  for plugin_key in $plugin_keys; do
    # Skip plugins that are not enabled in settings.json
    local is_enabled
    is_enabled=$(
      jq -r \
        --arg key "$plugin_key" \
        '.enabledPlugins[$key] // false' \
        "$SETTINGS_FILE" 2>/dev/null
    )
    if [ "$is_enabled" != "true" ]; then
      continue
    fi

    local install_path plugin_name marketplace_name commit

    install_path=$(
      jq -r \
        --arg key "$plugin_key" \
        '.plugins[$key][0].installPath' \
        "$INSTALLED_PLUGINS_FILE"
    )

    # Extract plugin name and marketplace from the key (format:
    # plugin@marketplace)
    plugin_name=$(printf "%s" "$plugin_key" | sed 's/@.*//')
    marketplace_name=$(printf "%s" "$plugin_key" | sed 's/.*@//')

    # Get commit from installed_plugins.json first, fall back to git check
    local commit="unknown"
    local git_commit_sha
    git_commit_sha=$(
      jq -r \
        --arg key "$plugin_key" \
        '.plugins[$key][0].gitCommitSha // "unknown"' \
        "$INSTALLED_PLUGINS_FILE"
    )

    if [ "$git_commit_sha" != "unknown" ] && [ "$git_commit_sha" != "null" ]; then
      commit="$git_commit_sha"
    elif [ -n "$install_path" ] && [ -d "$install_path" ]; then
      commit=$(get_git_commit "$install_path")
    fi

    # If still unknown, fall back to marketplace commit
    if [ "$commit" = "unknown" ]; then
      local marketplace_commit
      marketplace_commit=$(
        jq -r \
          --arg name "$marketplace_name" \
          '.[$name].commit // "unknown"' \
          "$MARKETPLACES_LOCK_FILE" 2>/dev/null
      )
      if [ "$marketplace_commit" != "unknown" ] && [ "$marketplace_commit" != "null" ]; then
        commit="$marketplace_commit"
      else
        printf "Warning: Skipping %s - could not determine commit\n" \
          "$plugin_name" >&2
        continue
      fi
    fi

    local entry
    entry=$(jq -n \
      --arg marketplace "$marketplace_name" \
      --arg commit "$commit" \
      --arg updated "$(date -u +%Y-%m-%d)" \
      '{marketplace: $marketplace, commit: $commit, updated: $updated}')

    # shellcheck disable=SC2016
    update_json_atomic "$PLUGINS_LOCK_FILE.tmp" \
      --arg name "$plugin_name" \
      --argjson entry "$entry" \
      '. + {($name): $entry}'

    printf "Captured: %s @ %s\n" "$plugin_name" "$commit"
  done

  cat "$PLUGINS_LOCK_FILE.tmp" >"$PLUGINS_LOCK_FILE" \
    && rm "$PLUGINS_LOCK_FILE.tmp"

  printf "\n--- Plugin Versions Update Summary ---\n"
  printf "Plugin versions saved to: %s\n" "$PLUGINS_LOCK_FILE"
  printf "Total plugins: %s\n" "$(jq 'length' "$PLUGINS_LOCK_FILE")"
  printf "\nPlugin version update complete!\n"

  return 0
}

# Verifies marketplaces against lock file
verify_marketplaces() {
  print_section "VERIFYING MARKETPLACES"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" \
      "$MARKETPLACES_LOCK_FILE" >&2
    printf "This file should be tracked in your dotfiles.\n" >&2
    return 1
  fi

  if [ ! -d "$MARKETPLACES_DIR" ]; then
    printf "Warning: Marketplaces directory not found: %s\n" \
      "$MARKETPLACES_DIR" >&2
    printf "Run 'claude-plugins update' to install marketplaces.\n" >&2
    return 0
  fi

  local marketplace_missing_count=0
  local marketplace_match_count=0
  local marketplace_mismatch_count=0
  local marketplace_extra_count=0
  local exit_code=0

  local expected_marketplaces
  expected_marketplaces=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE")

  for marketplace_name in $expected_marketplaces; do
    local marketplace_dir="$MARKETPLACES_DIR/$marketplace_name"
    local repo
    local expected_commit

    repo=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].repo' \
        "$MARKETPLACES_LOCK_FILE"
    )
    expected_commit=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].commit // "unknown"' \
        "$MARKETPLACES_LOCK_FILE"
    )

    if [ ! -d "$marketplace_dir" ]; then
      printf "MISSING: %s (from %s)\n" "$marketplace_name" "$repo"
      if [ "$expected_commit" != "unknown" ] && [ "$expected_commit" != "null" ]; then
        printf "  Expected @ %s\n" "$expected_commit"
      fi
      marketplace_missing_count=$((marketplace_missing_count + 1))
      exit_code=1
      continue
    fi

    local actual_commit
    actual_commit=$(get_git_commit "$marketplace_dir")

    if [ "$expected_commit" != "unknown" ] && [ "$expected_commit" != "null" ]; then
      if [ "$actual_commit" = "$expected_commit" ]; then
        printf "OK: %s @ %s\n" "$marketplace_name" "$actual_commit"
        marketplace_match_count=$((marketplace_match_count + 1))
      else
        printf "MISMATCH: %s\n" "$marketplace_name"
        printf "  Expected: %s\n" "$expected_commit"
        printf "  Actual:   %s\n" "$actual_commit"
        marketplace_mismatch_count=$((marketplace_mismatch_count + 1))
        exit_code=1
      fi
    else
      printf "OK: %s @ %s (no expected commit in lock file)\n" \
        "$marketplace_name" \
        "$actual_commit"
      marketplace_match_count=$((marketplace_match_count + 1))
    fi
  done

  for marketplace_dir in "$MARKETPLACES_DIR"/*; do
    if [ ! -d "$marketplace_dir" ]; then
      continue
    fi

    local marketplace_name
    local is_expected
    marketplace_name=$(basename "$marketplace_dir")
    is_expected=$(
      jq -r \
        --arg name "$marketplace_name" \
        'has($name)' \
        "$MARKETPLACES_LOCK_FILE"
    )

    if [ "$is_expected" = "false" ]; then
      printf "EXTRA: %s (not in lock file)\n" "$marketplace_name"
      marketplace_extra_count=$((marketplace_extra_count + 1))
    fi
  done

  printf "\n--- Marketplaces Summary ---\n"
  printf "Matching: %d\n" "$marketplace_match_count"
  printf "Missing:  %d\n" "$marketplace_missing_count"
  printf "Mismatch: %d\n" "$marketplace_mismatch_count"
  printf "Extra:    %d\n" "$marketplace_extra_count"

  if [ "$exit_code" -eq 0 ]; then
    printf "\nAll marketplaces match expected versions.\n"
  else
    printf "\nSome marketplaces need attention. Run 'claude-plugins update' to fix.\n"
  fi

  return "$exit_code"
}

# Verifies plugins against lock file
verify_plugins() {
  print_section "VERIFYING PLUGIN VERSIONS"

  if [ ! -f "$PLUGINS_LOCK_FILE" ]; then
    printf "Error: plugins lock file not found: %s\n" "$PLUGINS_LOCK_FILE" >&2
    printf "Run 'claude-plugins update' first to create it.\n" >&2
    return 1
  fi

  if [ ! -d "$CACHE_DIR" ]; then
    printf "Warning: Plugin cache directory not found: %s\n" "$CACHE_DIR" >&2
    printf "Plugins will be downloaded on first Claude Code run.\n" >&2
    return 0
  fi

  local plugin_missing_count=0
  local plugin_mismatch_count=0
  local plugin_extra_count=0
  local plugin_match_count=0
  local exit_code=0

  local expected_plugins
  expected_plugins=$(jq -r 'keys[]' "$PLUGINS_LOCK_FILE")

  for plugin_name in $expected_plugins; do
    local expected_commit
    local marketplace_name
    local plugin_dir
    local actual_commit="unknown"

    expected_commit=$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].commit' \
        "$PLUGINS_LOCK_FILE"
    )
    marketplace_name=$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].marketplace' \
        "$PLUGINS_LOCK_FILE"
    )

    # Look up actual install path and commit from installed_plugins.json
    if [ -f "$INSTALLED_PLUGINS_FILE" ]; then
      local plugin_key="${plugin_name}@${marketplace_name}"
      local install_path
      local git_commit_sha

      install_path=$(
        jq -r \
          --arg key "$plugin_key" \
          '.plugins[$key][0].installPath // empty' \
          "$INSTALLED_PLUGINS_FILE"
      )
      git_commit_sha=$(
        jq -r \
          --arg key "$plugin_key" \
          '.plugins[$key][0].gitCommitSha // "unknown"' \
          "$INSTALLED_PLUGINS_FILE"
      )

      if [ -n "$install_path" ]; then
        plugin_dir="$install_path"

        # First try to use gitCommitSha from installed_plugins.json
        if [ "$git_commit_sha" != "unknown" ] && [ "$git_commit_sha" != "null" ]; then
          actual_commit="$git_commit_sha"
        else
          # Fall back to checking git repo directly
          actual_commit=$(get_git_commit "$plugin_dir")
          # If still unknown, use marketplace commit as fallback
          if [ "$actual_commit" = "unknown" ]; then
            local marketplace_commit
            marketplace_commit=$(
              jq -r \
                --arg name "$marketplace_name" \
                '.[$name].commit // "unknown"' \
                "$MARKETPLACES_LOCK_FILE" 2>/dev/null
            )
            if [ "$marketplace_commit" != "unknown" ] && [ "$marketplace_commit" != "null" ]; then
              actual_commit="$marketplace_commit"
            fi
          fi
        fi
      else
        # Fall back to cache directory if not in installed_plugins.json
        plugin_dir="$CACHE_DIR/$plugin_name"
      fi
    else
      # Fall back to cache directory if installed_plugins.json doesn't exist
      plugin_dir="$CACHE_DIR/$plugin_name"
    fi

    if [ ! -d "$plugin_dir" ]; then
      printf "MISSING: %s (expected @ %s)\n" "$plugin_name" "$expected_commit"
      plugin_missing_count=$((plugin_missing_count + 1))
      exit_code=1
      continue
    fi

    # If we haven't gotten the commit yet, try from git directly
    if [ "$actual_commit" = "unknown" ]; then
      actual_commit=$(get_git_commit "$plugin_dir")
    fi

    if [ "$actual_commit" = "$expected_commit" ]; then
      printf "OK: %s @ %s\n" "$plugin_name" "$actual_commit"
      plugin_match_count=$((plugin_match_count + 1))
    else
      printf "MISMATCH: %s\n" "$plugin_name"
      printf "  Expected: %s\n" "$expected_commit"
      printf "  Actual:   %s\n" "$actual_commit"
      plugin_mismatch_count=$((plugin_mismatch_count + 1))
      exit_code=1
    fi
  done

  for plugin_dir in "$CACHE_DIR"/*; do
    if [ ! -d "$plugin_dir" ]; then
      continue
    fi

    local plugin_name
    local is_marketplace
    local is_expected
    plugin_name=$(basename "$plugin_dir")

    # Skip if this is a marketplace directory
    is_marketplace=$(
      jq -r \
        --arg name "$plugin_name" \
        'has($name)' \
        "$MARKETPLACES_LOCK_FILE" 2>/dev/null
    )
    if [ "$is_marketplace" = "true" ]; then
      continue
    fi

    is_expected=$(
      jq -r \
        --arg name "$plugin_name" \
        'has($name)' \
        "$PLUGINS_LOCK_FILE"
    )

    if [ "$is_expected" = "false" ]; then
      printf "EXTRA: %s (not in lock file)\n" "$plugin_name"
      plugin_extra_count=$((plugin_extra_count + 1))
    fi
  done

  printf "\n--- Plugin Versions Summary ---\n"
  printf "Matching: %d\n" "$plugin_match_count"
  printf "Missing:  %d\n" "$plugin_missing_count"
  printf "Mismatch: %d\n" "$plugin_mismatch_count"
  printf "Extra:    %d\n" "$plugin_extra_count"

  if [ "$exit_code" -eq 0 ]; then
    printf "\nAll plugins match expected versions.\n"
  else
    printf "\nSome plugins need attention.\n"
  fi

  return "$exit_code"
}

die() {
  printf "Error: %s\n" "$*" >&2
  exit 1
}

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    die "Required command '$1' not found on PATH"
  fi
}

# Prints section header banner
# Arguments:
#   $1 - Section title
print_section() {
  printf "=============================================================================\n"
  printf "%s\n" "$1"
  printf "=============================================================================\n\n"
}

# Prints overall summary banner
# Arguments:
#   $1 - Exit code (0 for success, non-zero for errors)
#   $2 - Success message
#   $3 - Error message
print_summary() {
  local exit_code="$1"
  local success_msg="$2"
  local error_msg="$3"

  printf "\n"
  print_section ""
  if [ "$exit_code" -eq 0 ]; then
    printf "✓ %s\n" "$success_msg"
  else
    printf "✗ %s\n" "$error_msg"
  fi
  printf "=============================================================================\n"
}

# Capitalizes the first letter of a string (POSIX-compatible)
# Arguments:
#   $1 - String to capitalize
# Returns: String with first letter capitalized
capitalize() {
  local str="$1"
  local first last
  first=$(printf "%s" "$str" | cut -c1 | tr '[:lower:]' '[:upper:]')
  last=$(printf "%s" "$str" | cut -c2-)
  printf "%s%s" "$first" "$last"
}

# Gets git commit SHA from a directory
# Arguments:
#   $1 - Directory path
# Returns: commit SHA or "unknown"
get_git_commit() {
  local dir="$1"
  if [ -d "$dir/.git" ]; then
    (cd "$dir" && git rev-parse HEAD 2>/dev/null) || printf "unknown"
  else
    printf "unknown"
  fi
}

# Atomically updates a JSON file using jq
# Arguments:
#   $1 - File path
#   $2+ - jq arguments and expressions
update_json_atomic() {
  local file="$1"
  shift
  jq --sort-keys "$@" "$file" >"$file.tmp" \
    && cat "$file.tmp" >"$file" \
    && rm "$file.tmp"
}

# Compares two lists and finds items in list1 not in list2
# Arguments:
#   $1 - List 1 (newline separated)
#   $2 - List 2 (newline separated)
# Returns: Items in list1 but not in list2
list_diff() {
  local list1="$1"
  local list2="$2"

  for item in $list1; do
    local in_list2
    in_list2=$(printf "%s\n" "$list2" | grep -x "$item" || printf "")
    if [ -z "$in_list2" ]; then
      printf "%s\n" "$item"
    fi
  done
}

main "$@"
