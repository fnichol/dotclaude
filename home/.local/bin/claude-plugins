#!/usr/bin/env sh
# shellcheck disable=SC3043

print_usage() {
  cat <<-EOF
	claude-plugins - Manage Claude Code plugin marketplaces and installations

	USAGE:
	    claude-plugins <SUBCOMMAND>

	SUBCOMMANDS:
	    capture    Capture live settings.json changes back into base or local overlay
	    help       Print this help message
	    install    Sync installed marketplaces and plugins to exact lock file versions
	    render     Render settings.json from settings.base.json + the local overlay
	    update     Install/update marketplaces and capture current plugin versions
	    verify     Verify installed marketplaces and plugins match lock file versions

	EOF
}

main() {
  set -eu
  if [ -n "${DEBUG:-}" ]; then set -v; fi
  if [ -n "${TRACE:-}" ]; then set -xv; fi

  local program=claude-plugins

  declare_globals
  parse_cli "$program" "$@"
}

declare_globals() {
  local claude_path="$HOME/.claude"
  local plugins_path="$claude_path/plugins"

  _SETTINGS_FILE_PATH="$claude_path/settings.json"
  _BASE_SETTINGS_FILE_PATH="$claude_path/settings.base.json"
  _LOCAL_SETTINGS_OVERLAY_FILE_PATH="$claude_path/settings.local-overlay.json"
  _RENDERED_SNAPSHOT_FILE_PATH="$claude_path/.settings.rendered.json"

  _KNOWN_MARKETPLACES_FILE_PATH="$plugins_path/known_marketplaces.json"
  _INSTALLED_PLUGINS_FILE_PATH="$plugins_path/installed_plugins.json"

  _MARKETPLACES_LOCK_FILE_PATH="$plugins_path/.marketplaces.lock.json"
  _PLUGINS_LOCK_FILE_PATH="$plugins_path/.plugins.lock.json"

  _CACHE_DIR_PATH="$plugins_path/cache"
  _MARKETPLACES_DIR_PATH="$plugins_path/marketplaces"

  # Newline-separated names of marketplaces whose commit changed during this
  # run, used to refresh local plugins that are copied from them
  _MOVED_MARKETPLACES=""

  # Top-level settings that Claude Code itself changes as you use it (e.g.
  # switching models). Rendering keeps their live value from settings.json,
  # falling back to base + overlay, and drift checks ignore them, so they never
  # show up as changes to capture or version.
  _LIVE_SETTINGS_KEYS='["model"]'
}

usage_and_die() {
  usage >&2
  die "$1"
}

ensure_prereqs() {
  need_cmd jq
  need_cmd git
  need_cmd claude

  # Claude Code's internal state files are not a public API so fail loudly and
  # immediately if their shape differs what this script expects.
  assert_known_marketplaces_schema
  assert_installed_plugins_schema

  setup_cleanups
  setup_traps trap_cleanups
}

parse_cli() {
  local program
  program="$1"
  shift

  usage() {
    print_usage "$program"
  }

  while [ $# -gt 0 ]; do
    case "$1" in
      # Flags
      -h | --help)
        usage
        return 0
        ;;
      # Parsing
      --) # explicitly terminates argument processing
        shift 1
        break
        ;;
      -?*)
        usage_and_die "invalid argument $1"
        ;;
      *)
        break
        ;;
    esac
  done

  local subcommand="${1:-}"
  if [ -z "$subcommand" ]; then
    usage
    return 0
  fi
  shift

  case "$subcommand" in
    c | capture)
      ensure_prereqs
      cmd_capture "$program" "$@"
      ;;
    h | help)
      usage
      return 0
      ;;
    i | install)
      ensure_prereqs
      cmd_install "$program" "$@"
      ;;
    r | render)
      ensure_prereqs
      cmd_render "$program" "$@"
      ;;
    u | update)
      ensure_prereqs
      cmd_update "$program" "$@"
      ;;
    v | verify)
      ensure_prereqs
      cmd_verify "$program" "$@"
      ;;
    *)
      usage_and_die "unknown subcommand: $subcommand"
      ;;
  esac
}

cmd_capture() {
  section "Capturing any current settings changes"

  local settings="$_SETTINGS_FILE_PATH"
  local base_settings="$_BASE_SETTINGS_FILE_PATH"
  local local_settings_overlay="$_LOCAL_SETTINGS_OVERLAY_FILE_PATH"
  local rendered_snapshot="$_RENDERED_SNAPSHOT_FILE_PATH"

  if [ ! -f "$settings" ]; then
    warn "$settings not found, run 'claude-plugins render' first" >&2
    return 1
  fi

  if [ ! -f "$rendered_snapshot" ]; then
    warn "No rendered snapshot found: $rendered_snapshot" >&2
    warn "Run 'claude-plugins render' first to establish a baseline." >&2
    return 1
  fi

  local changed
  changed=$(
    jq -n \
      --slurpfile live "$settings" \
      --slurpfile snap "$rendered_snapshot" \
      -r '
        def diffkeys(f):
          (($live[0][f] // {})) as $l |
          (($snap[0][f] // {})) as $s |
          (($l | keys) + ($s | keys) | unique)[] |
          select($l[.] != $s[.]) |
          f + ":" + .;
        diffkeys("enabledPlugins"), diffkeys("extraKnownMarketplaces")
      '
  )

  if [ -z "$changed" ]; then
    info "OK: no divergent changes to capture, settings matches last render"
    return 0
  fi

  info "Found divergent changes since last settings render:"

  local change field key value destination
  for change in $changed; do
    field="${change%%:*}"
    key="${change#*:}"
    value=$(jq -c --arg f "$field" --arg k "$key" '.[$f][$k]' "$settings")

    indent printf "  %s[%s] => %s\n" "$field" "$key" "$value"

    destination=""
    while true; do
      indent printf "    Capture into [base/local/skip]? "

      read -r destination </dev/tty 2>/dev/null || destination="skip"

      case "$destination" in
        base | local | skip)
          break
          ;;
        *)
          indent printf "    Please answer base, local, or skip.\n"
          ;;
      esac
    done

    case "$destination" in
      base)
        # shellcheck disable=SC2016
        update_json_atomic \
          "$base_settings" \
          --arg f "$field" \
          --arg k "$key" \
          --argjson v "$value" \
          '.[$f] = ((.[$f] // {}) + {($k): $v})'
        indent printf "    -> captured into %s\n" "$base_settings"
        ;;
      local)
        # shellcheck disable=SC2016
        update_json_atomic \
          "$local_settings_overlay" \
          --arg f "$field" \
          --arg k "$key" \
          --argjson v "$value" \
          '.[$f] = ((.[$f] // {}) + {($k): $v})'
        indent printf "    -> captured into %s\n" "$local_settings_overlay"
        ;;
      skip)
        indent printf "    -> skipped\n"
        ;;
    esac
  done

  printf "\n"

  render_settings quiet-drift-warning
}

cmd_install() {
  local exit_code=0

  render_settings || exit_code=1
  printf "\n"

  sync_marketplace_lock_file || exit_code=1
  printf "\n"

  install_marketplaces || exit_code=1
  printf "\n"

  sync_plugin_lock_file || exit_code=1
  printf "\n"

  install_plugins || exit_code=1

  print_summary "$exit_code" \
    "Marketplace and plugin sync completed successfully
All installations now match lock file versions." \
    "Some errors occurred during sync
Some installations may not match lock file versions."

  return "$exit_code"
}

cmd_render() {
  render_settings
}

cmd_update() {
  local exit_code=0

  update_marketplaces || exit_code=1
  printf "\n"

  update_plugin_versions || exit_code=1

  print_summary "$exit_code" \
    "Marketplace and plugin update completed successfully" \
    "Some errors occurred during update"

  return "$exit_code"
}

cmd_verify() {
  local result=0

  # Detect settings.json render drift (but don't fix)
  verify_settings_render || result=1
  printf "\n"

  # Detect marketplace lock file drift (but don't fix)
  verify_marketplace_lock_file || result=1
  printf "\n"

  verify_marketplaces || result=1
  printf "\n"

  # Detect plugin lock file drift (but don't fix)
  verify_plugin_lock_file || result=1
  printf "\n"

  verify_plugins || result=1

  print_summary "$result" \
    "All marketplaces and plugins verified successfully" \
    "Some marketplaces or plugins need attention"

  return "$result"
}

assert_installed_plugins_schema() {
  local file="$_INSTALLED_PLUGINS_FILE_PATH"

  if [ ! -f "$file" ]; then
    return 0
  fi

  if ! jq -e '
      has("plugins")
      and (.plugins | type == "object")
      and (.plugins | to_entries | all(
        (.value | type == "array")
        and (.value[0] | has("installPath"))
      ))
    ' "$file" >/dev/null 2>&1; then
    warn "Claude Code's internal plugin metadata format may have changed;" >&2
    warn "claude-plugins needs to be reviewed before it can be trusted against" >&2
    warn "this version of Claude Code." >&2
    die "Unexpected shape in $file"
  fi
}

assert_known_marketplaces_schema() {
  local file="$_KNOWN_MARKETPLACES_FILE_PATH"

  if [ ! -f "$file" ]; then
    return 0
  fi

  if ! jq -e '
      type == "object"
      and (to_entries | all(
        (.value.installLocation != null)
        and (.value.source.source != null)
      ))
    ' "$file" >/dev/null 2>&1; then
    warn "Claude Code's internal marketplace metadata format may have changed;" >&2
    warn "claude-plugins needs to be reviewed before it can be trusted against" >&2
    warn "this version of Claude Code." >&2
    die "Unexpected shape in $file"
  fi
}

capitalize() {
  local str="$1"

  printf "%s%s" \
    "$(printf "%s" "$str" | cut -c1 | tr '[:lower:]' '[:upper:]')" \
    "$(printf "%s" "$str" | cut -c2-)"
}

create_marketplace_lock_entry() {
  local name="$1"
  local source_obj source_type repo commit="unknown" marketplace_dir updated

  local known_marketplaces="$_KNOWN_MARKETPLACES_FILE_PATH"

  source_obj="$(
    jq -r --arg name "$name" '.[$name].source' "$known_marketplaces"
  )"
  source_type="$(printf "%s" "$source_obj" | jq -r '.source // "unknown"')"
  repo="$(printf "%s" "$source_obj" | jq -r '.repo // "unknown"')"
  marketplace_dir="$(
    jq -r \
      --arg name "$name" \
      '.[$name].installLocation' \
      "$known_marketplaces"
  )"

  if [ -n "$marketplace_dir" ] && [ -d "$marketplace_dir" ]; then
    commit="$(get_marketplace_commit "$marketplace_dir")"
    indent printf "  @ %s\n" "$commit" >&2
  fi

  updated="$(date -u +%Y-%m-%d)"

  jq -n \
    --arg source "$source_type" \
    --arg repo "$repo" \
    --arg commit "$commit" \
    --arg updated "$updated" \
    '{source: $source, repo: $repo, commit: $commit, updated: $updated}'
}

create_plugin_lock_entry() {
  local name="$1"
  local plugin_key="$2"
  local marketplace_name commit updated

  marketplace_name="$(printf "%s" "$plugin_key" | sed 's/.*@//')"
  commit="$(installed_plugin_commit "$plugin_key")"

  if plugin_follows_marketplace "$plugin_key"; then
    indent printf "  @ %s (local plugin, follows marketplace)\n" "$commit" >&2
  else
    indent printf "  @ %s\n" "$commit" >&2
  fi

  updated="$(date -u +%Y-%m-%d)"

  jq -n \
    --arg marketplace "$marketplace_name" \
    --arg commit "$commit" \
    --arg updated "$updated" \
    '{marketplace: $marketplace, commit: $commit, updated: $updated}'
}

# Prints the plugin@marketplace keys enabled in settings.base.json. Only these
# shared plugins are tracked in the (version-controlled) lock files; plugins
# enabled only in the local overlay stay local to this machine.
base_enabled_plugin_keys() {
  local base_settings="$_BASE_SETTINGS_FILE_PATH"

  if [ ! -f "$base_settings" ]; then
    return 0
  fi

  jq -r \
    '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' \
    "$base_settings"
}

# Prints the marketplaces settings.base.json depends on: those of its enabled
# plugins plus any it declares in extraKnownMarketplaces
base_marketplace_names() {
  local base_settings="$_BASE_SETTINGS_FILE_PATH"

  if [ ! -f "$base_settings" ]; then
    return 0
  fi

  {
    base_enabled_plugin_keys | sed 's/.*@//'
    jq -r '(.extraKnownMarketplaces // {}) | keys[]' "$base_settings"
  } | sed '/^$/d' | sort -u
}

# Prints the plugin@marketplace keys enabled in the rendered settings but not
# in settings.base.json, i.e. enabled only by the local overlay
local_enabled_plugin_keys() {
  local settings="$_SETTINGS_FILE_PATH"

  if [ ! -f "$settings" ]; then
    return 0
  fi

  local base_keys rendered_keys
  base_keys="$(base_enabled_plugin_keys | sort)"
  rendered_keys="$(
    jq -r \
      '(.enabledPlugins // {}) | to_entries[] | select(.value == true) | .key' \
      "$settings" \
      | sort
  )"

  list_diff "$rendered_keys" "$base_keys"
}

get_git_commit() {
  local dir="$1"

  if [ -d "$dir/.git" ]; then
    (cd "$dir" && git rev-parse HEAD 2>/dev/null) || printf "unknown"
  else
    printf "unknown"
  fi
}

# Prints the commit a marketplace directory is at. Claude Code installs some
# marketplaces (such as claude-plugins-official) as snapshots rather than git
# clones; those record their commit in a .gcs-sha file.
get_marketplace_commit() {
  local dir="$1"

  if [ -d "$dir/.git" ]; then
    get_git_commit "$dir"
  elif [ -s "$dir/.gcs-sha" ]; then
    tr -d '[:space:]' <"$dir/.gcs-sha"
  else
    printf "unknown"
  fi
}

get_plugin_source_from_marketplace() {
  local plugin_name="$1"
  local marketplace_name="$2"
  local marketplace_dir
  local marketplace_json

  local known_marketplaces="$_KNOWN_MARKETPLACES_FILE_PATH"

  marketplace_dir="$(
    jq -r \
      --arg name "$marketplace_name" \
      '.[$name].installLocation' \
      "$known_marketplaces" 2>/dev/null
  )"

  if [ -z "$marketplace_dir" ] || [ ! -d "$marketplace_dir" ]; then
    printf "unknown"
    return
  fi

  marketplace_json="$marketplace_dir/.claude-plugin/marketplace.json"
  if [ ! -f "$marketplace_json" ]; then
    printf "unknown"
    return
  fi

  local source_type
  source_type="$(
    jq -r \
      --arg name "$plugin_name" \
      '.plugins[] | select(.name == $name) | .source | if type == "object" then .source else "local" end' \
      "$marketplace_json" 2>/dev/null
  )"

  if [ "$source_type" = "url" ]; then
    local url
    url="$(
      jq -r \
        --arg name "$plugin_name" \
        '.plugins[] | select(.name == $name) | .source.url' \
        "$marketplace_json" 2>/dev/null
    )"
    printf "url %s" "$url"
  elif [ -n "$source_type" ]; then
    printf "local"
  else
    printf "unknown"
  fi
}

get_remote_git_commit() {
  local url="$1"

  git ls-remote "$url" HEAD 2>/dev/null \
    | awk '{print $1}' || printf "unknown"
}

install_marketplaces() {
  section "Syncing marketplaces to lock file"

  local lock_file="$_MARKETPLACES_LOCK_FILE_PATH"
  local known_marketplaces="$_KNOWN_MARKETPLACES_FILE_PATH"

  if [ ! -f "$lock_file" ]; then
    warn "Marketplaces lock file not found: $lock_file" >&2
    warn "Run 'claude-plugins update' first to create it" >&2
    return 1
  fi

  local marketplace_synced_count=0
  local marketplace_skipped_count=0
  local marketplace_names
  local exit_code=0

  marketplace_names=$(jq -r 'keys[]' "$lock_file")

  for marketplace_name in $marketplace_names; do
    local source
    local repo
    local expected_commit

    source="$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].source' \
        "$lock_file"
    )"
    repo="$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].repo' \
        "$lock_file"
    )"
    expected_commit="$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].commit // "unknown"' \
        "$lock_file"
    )"

    if [ "$source" != "github" ]; then
      warn "Skipping $marketplace_name - only 'github' source is supported" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    if [ -z "$repo" ] || [ "$repo" = "null" ]; then
      warn "Skipping $marketplace_name - no repo specified" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    if [ "$expected_commit" = "unknown" ] \
      || [ "$expected_commit" = "null" ]; then
      warn "Skipping $marketplace_name - no commit specified in lock file" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    # Add the marketplace via the claude CLI if it is not installed yet
    local is_installed
    is_installed="$(
      jq -r \
        --arg name "$marketplace_name" \
        'has($name)' \
        "$known_marketplaces" 2>/dev/null \
        || printf "false"
    )"

    if [ "$is_installed" != "true" ]; then
      info "Installing: $marketplace_name (from $repo)"

      if ! claude plugin marketplace add "$repo" >/dev/null 2>&1; then
        warn "Could not add marketplace via 'claude plugin marketplace add'" >&2
        exit_code=1
        continue
      fi
    fi

    local marketplace_dir
    marketplace_dir="$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].installLocation // empty' \
        "$known_marketplaces" 2>/dev/null
    )"

    if [ -z "$marketplace_dir" ] || [ ! -d "$marketplace_dir" ]; then
      warn "Could not find installed marketplace directory" >&2
      exit_code=1
      continue
    fi

    local actual_commit
    actual_commit="$(get_marketplace_commit "$marketplace_dir")"

    if [ "$actual_commit" = "$expected_commit" ]; then
      if [ "$is_installed" = "true" ]; then
        info "Already synced: $marketplace_name @ $expected_commit"
      else
        indent printf "  @ %s\n" "$expected_commit"
        marketplace_synced_count=$((marketplace_synced_count + 1))
      fi
      continue
    fi

    indent printf "Syncing: %s\n" "$marketplace_name"
    indent printf "  From: %s\n" "$actual_commit"
    indent printf "  To:   %s\n" "$expected_commit"

    if [ -d "$marketplace_dir/.git" ]; then
      git -C "$marketplace_dir" fetch origin >/dev/null 2>&1 || {
        warn "Could not fetch from origin" >&2
      }

      if ! git -C "$marketplace_dir" reset --hard "$expected_commit" \
        >/dev/null 2>&1; then
        warn "Could not reset to commit $expected_commit" >&2
        exit_code=1
        continue
      fi
    else
      # A snapshot marketplace (no git checkout) cannot be pinned to a
      # commit, so ask Claude Code to refresh it and see where it lands
      if ! claude plugin marketplace update "$marketplace_name" \
        >/dev/null 2>&1; then
        warn "Could not update marketplace" >&2
      fi

      local current_commit
      current_commit="$(get_marketplace_commit "$marketplace_dir")"

      if [ "$current_commit" != "$actual_commit" ]; then
        mark_marketplace_moved "$marketplace_name"
      fi

      if [ "$current_commit" != "$expected_commit" ]; then
        warn "Cannot pin $marketplace_name to $expected_commit: Claude Code installs it as a snapshot, now at $current_commit" >&2
        warn "Run 'claude-plugins update' to lock the current snapshot" >&2
        marketplace_skipped_count=$((marketplace_skipped_count + 1))
        continue
      fi
    fi

    mark_marketplace_moved "$marketplace_name"
    marketplace_synced_count=$((marketplace_synced_count + 1))
  done

  printf "\n"
  section "Marketplace Sync Summary"
  indent printf "Lock file: %s\n" "$lock_file"
  indent printf "Synced:  %d\n" "$marketplace_synced_count"
  indent printf "Skipped: %d\n" "$marketplace_skipped_count"
  printf "\n"
  indent printf "Marketplace sync complete!\n"

  return "$exit_code"
}

install_plugins() {
  section "Syncing plugins to lock file"

  local lock_file="$_PLUGINS_LOCK_FILE_PATH"
  local installed_plugins_file="$_INSTALLED_PLUGINS_FILE_PATH"

  if [ ! -f "$lock_file" ]; then
    warn "Plugins lock file not found: $lock_file" >&2
    warn "Run 'claude-plugins update' first to create it" >&2
    return 1
  fi

  local plugin_synced_count=0
  local plugin_skipped_count=0
  local plugin_names
  local exit_code=0

  plugin_names=$(jq -r 'keys[]' "$lock_file")

  for plugin_name in $plugin_names; do
    local marketplace_name
    local expected_commit

    marketplace_name="$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].marketplace' \
        "$lock_file"
    )"
    expected_commit="$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].commit' \
        "$lock_file"
    )"

    if [ -z "$marketplace_name" ] \
      || [ "$marketplace_name" = "null" ] \
      || [ "$marketplace_name" = "unknown" ]; then
      warn "Skipping $plugin_name - no marketplace specified" >&2
      plugin_skipped_count=$((plugin_skipped_count + 1))
      continue
    fi

    if [ "$expected_commit" = "unknown" ] \
      || [ "$expected_commit" = "null" ]; then
      warn "Skipping $plugin_name - no commit specified in lock file" >&2
      plugin_skipped_count=$((plugin_skipped_count + 1))
      continue
    fi

    # Check if plugin is already installed
    #
    # Search by plugin name across all marketplaces (handles URL vs name
    # mismatch)
    local installed_plugin_key
    installed_plugin_key="$(
      jq -r \
        --arg name "$plugin_name" \
        '.plugins | keys[] | select(startswith($name + "@"))' \
        "$installed_plugins_file" 2>/dev/null \
        | head -n 1
    )"

    local is_installed
    if [ -n "$installed_plugin_key" ]; then
      is_installed="true"
    else
      is_installed="false"
    fi

    if [ "$is_installed" = "true" ]; then
      # Plugin exists, check if it's at the right commit
      local actual_commit
      actual_commit="$(installed_plugin_commit "$installed_plugin_key")"

      # A local plugin is a copy taken from its marketplace and its commit
      # follows the marketplace, so reinstalling can never move it to a
      # different commit. Refresh the copy only when this run moved its
      # marketplace.
      local follows=false refresh=false
      if plugin_follows_marketplace "$installed_plugin_key"; then
        follows=true
        if marketplace_moved "${installed_plugin_key##*@}"; then
          refresh=true
        fi
      fi

      if [ "$refresh" = false ] \
        && { [ "$actual_commit" = "$expected_commit" ] \
          || [ "$follows" = true ]; }; then
        info "Already synced: $plugin_name @ $actual_commit"
        if [ "$actual_commit" != "$expected_commit" ]; then
          warn "Lock commit for $plugin_name ($expected_commit) differs from its marketplace ($actual_commit)" >&2
          warn "Run 'claude-plugins update' to re-lock it" >&2
        fi
        continue
      else
        indent printf "Syncing: %s\n" "$plugin_name"
        if [ "$refresh" = true ]; then
          indent printf "  Reason: marketplace %s moved\n" \
            "${installed_plugin_key##*@}"
        fi
        indent printf "  From: %s\n" "$actual_commit"
        indent printf "  To:   %s\n" "$expected_commit"

        # Reinstall plugin to get it from marketplace at correct commit
        if ! claude plugin remove "$installed_plugin_key" >/dev/null 2>&1; then
          warn "Could not remove plugin" >&2
        fi

        local plugin_key="${plugin_name}@${marketplace_name}"
        if ! claude plugin install "$plugin_key" >/dev/null 2>&1; then
          warn "Could not install plugin via 'claude plugin install'" >&2
          exit_code=1
          continue
        fi
        indent printf "  @ %s\n" "$expected_commit"
        plugin_synced_count=$((plugin_synced_count + 1))
      fi
    else
      # Plugin not installed, install it via claude CLI
      # Construct plugin_key using marketplace_name from lock file
      local plugin_key="${plugin_name}@${marketplace_name}"
      info "Installing: $plugin_name (from $marketplace_name)"

      if ! claude plugin install "$plugin_key" >/dev/null 2>&1; then
        warn "Could not install plugin via 'claude plugin install'" >&2
        exit_code=1
        continue
      fi

      # Plugin installed from marketplace at its current commit
      indent printf "  @ %s\n" "$expected_commit"
      plugin_synced_count=$((plugin_synced_count + 1))
    fi
  done

  printf "\n"
  section "Plugin Sync Summary"
  indent printf "Lock file: %s\n" "$lock_file"
  indent printf "Synced:  %d\n" "$plugin_synced_count"
  indent printf "Skipped: %d\n" "$plugin_skipped_count"
  printf "\n"
  indent printf "Plugin sync complete!\n"

  return "$exit_code"
}

installed_plugin_commit() {
  local plugin_key="$1"

  local installed_plugins_file="$_INSTALLED_PLUGINS_FILE_PATH"
  local marketplaces_lock_file="$_MARKETPLACES_LOCK_FILE_PATH"

  if [ ! -f "$installed_plugins_file" ]; then
    printf "unknown"
    return 0
  fi

  local git_commit_sha
  git_commit_sha="$(
    jq -r \
      --arg key "$plugin_key" \
      '.plugins[$key][0].gitCommitSha // "unknown"' \
      "$installed_plugins_file"
  )"

  if [ "$git_commit_sha" != "unknown" ]; then
    printf "%s" "$git_commit_sha"
    return 0
  fi

  local install_path
  install_path="$(
    jq -r \
      --arg key "$plugin_key" \
      '.plugins[$key][0].installPath // empty' \
      "$installed_plugins_file"
  )"

  if [ -z "$install_path" ]; then
    printf "unknown"
    return 0
  fi

  local commit
  commit="$(get_git_commit "$install_path")"

  if [ "$commit" != "unknown" ]; then
    printf "%s" "$commit"
    return 0
  fi

  # A local plugin has no commit of its own, so it follows its marketplace
  local marketplace_name="${plugin_key##*@}"

  jq -r \
    --arg name "$marketplace_name" \
    '.[$name].commit // "unknown"' \
    "$marketplaces_lock_file" 2>/dev/null \
    || printf "unknown"
}

keep_lock_entry() {
  local source_lock_file="$1"
  local target_lock_file="$2"
  local name="$3"

  # shellcheck disable=SC2016
  update_json_atomic \
    "$target_lock_file" \
    --arg name "$name" \
    --slurpfile source "$source_lock_file" \
    'if $source[0] | has($name) then . + {($name): $source[0][$name]} else . end'
}

list_diff() {
  local list1="$1"
  local list2="$2"

  for item in $list1; do
    local in_list2
    in_list2=$(printf "%s\n" "$list2" | grep -Fx "$item" || printf "")
    if [ -z "$in_list2" ]; then
      printf "%s\n" "$item"
    fi
  done
}

mark_marketplace_moved() {
  _MOVED_MARKETPLACES="${_MOVED_MARKETPLACES}${1}
"
}

marketplace_moved() {
  printf "%s" "$_MOVED_MARKETPLACES" | grep -Fqx "$1"
}

# Prints the changes that would bring the marketplaces lock file in line with
# the marketplaces settings.base.json depends on, one per line:
#
#   add <name>       wanted and installed but not in the lock file
#   unlocked <name>  wanted but neither installed nor in the lock file
#   remove <name>    in the lock file but no longer wanted
#   local <name>     installed but not wanted (local to this machine, untracked)
plan_marketplace_lock_changes() {
  local lock_file="$_MARKETPLACES_LOCK_FILE_PATH"
  local known_marketplaces="$_KNOWN_MARKETPLACES_FILE_PATH"

  local lock_names installed_names wanted_names
  lock_names="$(jq -r 'keys[]' "$lock_file" | sort)"
  installed_names=""
  if [ -f "$known_marketplaces" ]; then
    installed_names="$(jq -r 'keys[]' "$known_marketplaces" | sort)"
  fi
  wanted_names="$(base_marketplace_names)"

  local name
  for name in $wanted_names; do
    if printf "%s\n" "$lock_names" | grep -Fqx "$name"; then
      continue
    fi

    if printf "%s\n" "$installed_names" | grep -Fqx "$name"; then
      printf "add %s\n" "$name"
    else
      printf "unlocked %s\n" "$name"
    fi
  done

  local extra local_only
  extra="$(list_diff "$lock_names" "$wanted_names")"
  local_only="$(list_diff "$(list_diff "$installed_names" "$wanted_names")" "$lock_names")"

  for name in $extra; do
    printf "remove %s\n" "$name"
  done
  for name in $local_only; do
    printf "local %s\n" "$name"
  done
}

# Prints the changes that would bring the plugins lock file in line with the
# plugins enabled in settings.base.json, one per line:
#
#   add <name> <key>       enabled and installed but not in the lock file
#   unlocked <name> <key>  enabled but neither installed nor in the lock file
#   remove <name>          in the lock file but not enabled in the base
#   local <name> <key>     enabled only by the local overlay (untracked)
#
# Plugins that are enabled and locked but not yet installed are left alone so
# that install can install them.
plan_plugin_lock_changes() {
  local lock_file="$_PLUGINS_LOCK_FILE_PATH"

  local lock_names wanted_keys wanted_names
  lock_names="$(jq -r 'keys[]' "$lock_file" | sort)"
  wanted_keys="$(base_enabled_plugin_keys | sort)"
  wanted_names="$(
    printf "%s\n" "$wanted_keys" \
      | sed 's/@.*//' \
      | sed '/^$/d' \
      | sort -u
  )"

  local key name
  for key in $wanted_keys; do
    name="$(printf "%s" "$key" | sed 's/@.*//')"

    if printf "%s\n" "$lock_names" | grep -Fqx "$name"; then
      continue
    fi

    if plugin_is_installed "$key"; then
      printf "add %s %s\n" "$name" "$key"
    else
      printf "unlocked %s %s\n" "$name" "$key"
    fi
  done

  local extra local_keys
  extra="$(list_diff "$lock_names" "$wanted_names")"
  local_keys="$(local_enabled_plugin_keys)"

  for name in $extra; do
    printf "remove %s\n" "$name"
  done
  for key in $local_keys; do
    printf "local %s %s\n" "$(printf "%s" "$key" | sed 's/@.*//')" "$key"
  done
}

plugin_follows_marketplace() {
  local plugin_key="$1"

  local installed_plugins_file="$_INSTALLED_PLUGINS_FILE_PATH"

  if ! jq -e \
    --arg key "$plugin_key" \
    '.plugins[$key][0] | has("installPath") and (.gitCommitSha == null)' \
    "$installed_plugins_file" >/dev/null 2>&1; then
    return 1
  fi

  local install_path
  install_path="$(
    jq -r \
      --arg key "$plugin_key" \
      '.plugins[$key][0].installPath' \
      "$installed_plugins_file"
  )"

  [ ! -d "$install_path/.git" ]
}

plugin_is_installed() {
  local plugin_key="$1"

  local installed_plugins_file="$_INSTALLED_PLUGINS_FILE_PATH"

  [ -f "$installed_plugins_file" ] \
    && jq -e \
      --arg key "$plugin_key" \
      '.plugins | has($key)' \
      "$installed_plugins_file" >/dev/null 2>&1
}

print_summary() {
  local exit_code="$1"
  local success_msg="$2"
  local error_msg="$3"

  printf "\n"
  section "Summary"
  if [ "$exit_code" -eq 0 ]; then
    indent printf "✓ %s\n" "$success_msg"
  else
    indent printf "✗ %s\n" "$error_msg"
  fi
}

# render_settings_json <base> <overlay>: prints base merged with overlay, with
# the live settings keys taken from the current settings.json when present
render_settings_json() {
  local base_settings="$1"
  local overlay="$2"

  local live="$_SETTINGS_FILE_PATH"
  if [ ! -f "$live" ] || ! jq -e . "$live" >/dev/null 2>&1; then
    live=/dev/null
  fi

  jq -n --sort-keys \
    --slurpfile base "$base_settings" \
    --slurpfile overlay "$overlay" \
    --slurpfile live "$live" \
    --argjson live_keys "$_LIVE_SETTINGS_KEYS" \
    '($live[0] // {}) as $current
    | reduce $live_keys[] as $key ($base[0] * $overlay[0];
        if $current | has($key) then .[$key] = $current[$key] else . end)'
}

# settings_differ <file> <file>: true if two settings files differ in anything
# other than the live settings keys
settings_differ() {
  # shellcheck disable=SC2016
  local filter='delpaths([$keys[] | [.]])'

  [ "$(jq -S --argjson keys "$_LIVE_SETTINGS_KEYS" "$filter" "$1")" \
    != "$(jq -S --argjson keys "$_LIVE_SETTINGS_KEYS" "$filter" "$2")" ]
}

render_settings() {
  local mode="${1:-}"

  local settings="$_SETTINGS_FILE_PATH"
  local base_settings="$_BASE_SETTINGS_FILE_PATH"
  local local_settings_overlay="$_LOCAL_SETTINGS_OVERLAY_FILE_PATH"
  local rendered_snapshot="$_RENDERED_SNAPSHOT_FILE_PATH"

  section "Rendering settings"

  if [ ! -f "$base_settings" ]; then
    warn "Base settings file not found: $base_settings" >&2
    return 1
  fi

  if [ ! -f "$local_settings_overlay" ]; then
    info "No local overlay found, creating stub: $local_settings_overlay"
    jq -n '{enabledPlugins: {}, extraKnownMarketplaces: {}}' \
      >"$local_settings_overlay"
    info "This file is never version-controlled; see README.md for usage."
  fi

  if [ "$mode" != "quiet-drift-warning" ] \
    && [ -f "$settings" ] && [ -f "$rendered_snapshot" ] \
    && settings_differ "$settings" "$rendered_snapshot"; then
    warn "Warning: settings has changes since the last render" >&2
    warn "(likely from toggling plugins in Claude Code)." >&2
    warn "Run 'claude-plugins capture' first to preserve them." >&2
    warn "Proceeding to overwrite with the rendered result." >&2
  fi

  if ! render_settings_json "$base_settings" "$local_settings_overlay" \
    >"$settings.tmp"; then
    warn "Failed to render settings from base and overlay" >&2
    rm -f "$settings.tmp"
    return 1
  fi

  mv "$settings.tmp" "$settings"
  cp "$settings" "$rendered_snapshot"

  info "Rendered: $settings"
  indent printf "  base:          %s\n" "$base_settings"
  indent printf "  local overlay: %s\n" "$local_settings_overlay"

  return 0
}

sync_lock_file() {
  local item_type="$1"
  local item_type_plural="$2"
  local lock_file="$3"
  local plan_fn="$4"
  local create_entry_fn="$5"

  local base_settings="$_BASE_SETTINGS_FILE_PATH"

  section "Syncing $item_type_plural lock file"

  if [ ! -f "$lock_file" ]; then
    warn "$item_type lock file not found: $lock_file" >&2
    return 1
  fi

  # settings.base.json decides what the lock files keep, so never prune a
  # lock file without it
  if [ ! -f "$base_settings" ]; then
    warn "Base settings file not found: $base_settings" >&2
    return 1
  fi

  local plan
  plan="$("$plan_fn")"

  local added_count=0 removed_count=0 exit_code=0
  local action name key entry

  while read -r action name key; do
    case "$action" in
      add)
        info "Adding to lock file: $name"
        entry="$("$create_entry_fn" "$name" "$key")"
        # shellcheck disable=SC2016
        update_json_atomic \
          "$lock_file" \
          --arg name "$name" \
          --argjson entry "$entry" \
          '. + {($name): $entry}'
        added_count=$((added_count + 1))
        ;;
      remove)
        info "Removing from lock file: $name"
        # shellcheck disable=SC2016
        update_json_atomic \
          "$lock_file" \
          --arg name "$name" \
          'del(.[$name])'
        removed_count=$((removed_count + 1))
        ;;
      unlocked)
        if [ "$item_type" = "plugin" ]; then
          warn "Plugin $key is enabled in the base but neither installed nor locked" >&2
        else
          warn "Marketplace $name is used by the base but neither installed nor locked" >&2
        fi
        warn "Install it, then run 'claude-plugins update' to lock it" >&2
        exit_code=1
        ;;
      local)
        info "Local only: ${key:-$name} (not tracked in the lock file)"
        ;;
    esac
  done <<EOF
$plan
EOF

  local item_type_cap
  item_type_cap="$(capitalize "$item_type")"

  if [ "$added_count" -eq 0 ] && [ "$removed_count" -eq 0 ]; then
    info "OK: $item_type_cap lock file is already up to date"
  else
    printf "\n"
    section "$item_type_cap Lock File Sync Summary"
    indent printf "Added:   %d\n" "$added_count"
    indent printf "Removed: %d\n" "$removed_count"
    printf "\n"
    indent printf "%s lock file updated!\n" "$item_type_cap"
  fi

  return "$exit_code"
}

sync_marketplace_lock_file() {
  sync_lock_file \
    "marketplace" \
    "marketplaces" \
    "$_MARKETPLACES_LOCK_FILE_PATH" \
    plan_marketplace_lock_changes \
    create_marketplace_lock_entry
}

sync_plugin_lock_file() {
  sync_lock_file \
    "plugin" \
    "plugins" \
    "$_PLUGINS_LOCK_FILE_PATH" \
    plan_plugin_lock_changes \
    create_plugin_lock_entry
}

update_json_atomic() {
  local target="$1"
  shift

  local tmpfile
  tmpfile=$(mktemp_file)
  cleanup_file "$tmpfile"

  jq --sort-keys "$@" "$target" >"$tmpfile" \
    && cat "$tmpfile" >"$target"
}

update_marketplaces() {
  section "Updating marketplaces"

  local lock_file="$_MARKETPLACES_LOCK_FILE_PATH"
  local known_marketplaces="$_KNOWN_MARKETPLACES_FILE_PATH"

  if [ ! -f "$lock_file" ]; then
    warn "Marketplaces lock file not found: $lock_file" >&2
    return 1
  fi

  printf "{}\n" >"$lock_file.tmp"

  local marketplace_names
  marketplace_names=$(jq -r 'keys[]' "$lock_file")

  for marketplace_name in $marketplace_names; do
    local source
    local repo

    source="$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].source' \
        "$lock_file"
    )"
    repo="$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].repo' \
        "$lock_file"
    )"

    # Skipped marketplaces keep their existing lock entry rather than being
    # dropped from the rebuilt lock file
    if [ "$source" != "github" ]; then
      warn "Skipping $marketplace_name - only 'github' source is supported" >&2
      keep_lock_entry "$lock_file" "$lock_file.tmp" "$marketplace_name"
      continue
    fi

    if [ -z "$repo" ] || [ "$repo" = "null" ]; then
      warn "Skipping $marketplace_name - no repo specified" >&2
      keep_lock_entry "$lock_file" "$lock_file.tmp" "$marketplace_name"
      continue
    fi

    # Check if marketplace is already tracked by claude CLI
    local is_known
    is_known="$(
      jq -r \
        --arg name "$marketplace_name" \
        'has($name)' \
        "$known_marketplaces" 2>/dev/null \
        || printf "false"
    )"

    if [ "$is_known" = "false" ]; then
      info "Adding: $marketplace_name (from $repo)"
      if ! claude plugin marketplace add "$repo" >/dev/null 2>&1; then
        warn "Could not add marketplace" >&2
        keep_lock_entry "$lock_file" "$lock_file.tmp" "$marketplace_name"
        continue
      fi
    fi

    local marketplace_dir previous_commit commit
    marketplace_dir="$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].installLocation // empty' \
        "$known_marketplaces" 2>/dev/null
    )"

    previous_commit="unknown"
    if [ -n "$marketplace_dir" ]; then
      previous_commit="$(get_marketplace_commit "$marketplace_dir")"
    fi

    info "Updating: $marketplace_name"
    if ! claude plugin marketplace update "$marketplace_name" >/dev/null 2>&1; then
      warn "Could not update marketplace" >&2
    fi

    # Get the current commit after update
    if [ -n "$marketplace_dir" ]; then
      commit="$(get_marketplace_commit "$marketplace_dir")"
      indent printf "  @ %s\n" "$commit"
    else
      commit="unknown"
    fi

    if [ "$previous_commit" != "unknown" ] \
      && [ "$previous_commit" != "$commit" ]; then
      mark_marketplace_moved "$marketplace_name"
    fi

    local entry
    entry="$(
      jq -n \
        --arg source "$source" \
        --arg repo "$repo" \
        --arg commit "$commit" \
        --arg updated "$(date -u +%Y-%m-%d)" \
        '{source: $source, repo: $repo, commit: $commit, updated: $updated}'
    )"

    # shellcheck disable=SC2016
    update_json_atomic "$lock_file.tmp" \
      --arg name "$marketplace_name" \
      --argjson entry "$entry" \
      '. + {($name): $entry}'
  done

  cat "$lock_file.tmp" >"$lock_file" \
    && rm "$lock_file.tmp"

  printf "\n"
  section "Marketplace Update Summary"
  indent printf "Lock file: %s\n" "$lock_file"
  indent printf "Total marketplaces: %s\n" "$(jq 'length' "$lock_file")"
  printf "\n"
  indent printf "Marketplace update complete!\n"

  return 0
}

update_plugin_versions() {
  section "Updating plugin versions"

  local lock_file="$_PLUGINS_LOCK_FILE_PATH"
  local installed_plugins_file="$_INSTALLED_PLUGINS_FILE_PATH"
  local base_settings="$_BASE_SETTINGS_FILE_PATH"

  if [ ! -f "$installed_plugins_file" ]; then
    warn "No plugins installed yet." >&2
    warn "Skipping plugin version update." >&2
    return 0
  fi

  printf "{}\n" >"$lock_file.tmp"

  # Iterate through all installed plugins
  local plugin_keys
  plugin_keys=$(jq -r '.plugins | keys[]' "$installed_plugins_file" 2>/dev/null)

  for plugin_key in $plugin_keys; do
    # Only plugins enabled in settings.base.json are tracked in the lock file;
    # plugins enabled only by the local overlay stay local to this machine
    local is_enabled
    is_enabled="$(
      jq -r \
        --arg key "$plugin_key" \
        '.enabledPlugins[$key] // false' \
        "$base_settings" 2>/dev/null
    )"
    if [ "$is_enabled" != "true" ]; then
      continue
    fi

    local plugin_name marketplace_name commit git_commit_sha

    # Extract plugin name and marketplace from the key (format:
    # plugin@marketplace)
    plugin_name="$(printf "%s" "$plugin_key" | sed 's/@.*//')"
    marketplace_name="$(printf "%s" "$plugin_key" | sed 's/.*@//')"

    # A local plugin is a copy taken from its marketplace, so refresh it when
    # the marketplace update above moved the marketplace
    if marketplace_moved "$marketplace_name" \
      && plugin_follows_marketplace "$plugin_key"; then
      indent printf "Refreshing: %s (marketplace %s moved)\n" \
        "$plugin_name" "$marketplace_name"

      if ! claude plugin remove "$plugin_key" >/dev/null 2>&1; then
        warn "Could not remove plugin" >&2
      fi
      if ! claude plugin install "$plugin_key" >/dev/null 2>&1; then
        warn "Could not reinstall plugin" >&2
      fi
    fi

    commit="$(installed_plugin_commit "$plugin_key")"

    # Check if plugin is URL-sourced and has a newer version available
    if [ "$commit" != "unknown" ]; then
      local plugin_source
      plugin_source="$(
        get_plugin_source_from_marketplace "$plugin_name" "$marketplace_name"
      )"

      if [ "${plugin_source#url }" != "$plugin_source" ]; then
        # Extract URL from "url <git-url>" format
        local remote_url="${plugin_source#url }"
        local remote_commit
        remote_commit="$(get_remote_git_commit "$remote_url")"

        if [ "$remote_commit" != "unknown" ] \
          && [ "$remote_commit" != "$commit" ]; then
          indent printf "Updating: %s (URL-sourced plugin has newer version)\n" "$plugin_name"
          indent printf "  From: %s\n" "$commit"
          indent printf "  To:   %s\n" "$remote_commit"

          # Reinstall plugin to get latest version
          if ! claude plugin remove "$plugin_key" >/dev/null 2>&1; then
            warn "Could not remove plugin" >&2
          fi

          if ! claude plugin install "$plugin_key" >/dev/null 2>&1; then
            warn "Could not reinstall plugin" >&2
          else
            # Re-read the updated gitCommitSha after reinstall
            git_commit_sha="$(
              jq -r \
                --arg key "$plugin_key" \
                '.plugins[$key][0].gitCommitSha // "unknown"' \
                "$installed_plugins_file"
            )"
            if [ "$git_commit_sha" != "unknown" ] \
              && [ "$git_commit_sha" != "null" ]; then
              commit="$git_commit_sha"
              indent printf "  Updated to: %s\n" "$commit"
            fi
          fi
        fi
      fi
    fi

    if [ "$commit" = "unknown" ]; then
      warn "Skipping $plugin_name - could not determine commit" >&2
      if [ -f "$lock_file" ]; then
        keep_lock_entry "$lock_file" "$lock_file.tmp" "$plugin_name"
      fi
      continue
    fi

    local entry
    entry="$(
      jq -n \
        --arg marketplace "$marketplace_name" \
        --arg commit "$commit" \
        --arg updated "$(date -u +%Y-%m-%d)" \
        '{marketplace: $marketplace, commit: $commit, updated: $updated}'
    )"

    # shellcheck disable=SC2016
    update_json_atomic \
      "$lock_file.tmp" \
      --arg name "$plugin_name" \
      --argjson entry "$entry" \
      '. + {($name): $entry}'

    info "Captured: $plugin_name @ $commit"
  done

  # Plugins enabled in settings but not installed on this machine keep their
  # existing lock entry rather than being dropped from the rebuilt lock file
  local enabled_keys
  enabled_keys="$(base_enabled_plugin_keys)"

  for plugin_key in $enabled_keys; do
    if plugin_is_installed "$plugin_key"; then
      continue
    fi

    local plugin_name
    plugin_name="$(printf "%s" "$plugin_key" | sed 's/@.*//')"

    if [ -f "$lock_file" ] \
      && jq -e --arg name "$plugin_name" 'has($name)' "$lock_file" \
        >/dev/null 2>&1; then
      warn "Keeping $plugin_name - enabled but not installed on this machine" >&2
      keep_lock_entry "$lock_file" "$lock_file.tmp" "$plugin_name"
    fi
  done

  cat "$lock_file.tmp" >"$lock_file" \
    && rm "$lock_file.tmp"

  printf "\n"
  section "Plugin Versions Update Summary"
  indent printf "Plugin versions saved to: %s\n" "$lock_file"
  indent printf "Total plugins: %s\n" "$(jq 'length' "$lock_file")"
  printf "\n"
  indent printf "Plugin version update complete!\n"

  return 0
}

verify_lock_file_drift() {
  local item_type="$1"
  local item_type_plural="$2"
  local lock_file="$3"
  local plan_fn="$4"

  local base_settings="$_BASE_SETTINGS_FILE_PATH"

  section "Checking $item_type_plural lock file drift"

  if [ ! -f "$lock_file" ]; then
    warn "$item_type lock file not found: $lock_file" >&2
    return 1
  fi

  if [ ! -f "$base_settings" ]; then
    warn "Base settings file not found: $base_settings" >&2
    return 1
  fi

  local plan
  plan="$("$plan_fn")"

  local item_type_cap
  item_type_cap="$(capitalize "$item_type")"

  local missing_count=0 extra_count=0 result=0
  local action name key

  while read -r action name key; do
    case "$action" in
      add)
        warn "DRIFT: $item_type_cap '$name' is in Claude but not in lock file"
        missing_count=$((missing_count + 1))
        result=1
        ;;
      remove)
        if [ "$item_type" = "plugin" ]; then
          warn "DRIFT: Plugin '$name' is in lock file but not enabled in the base settings"
        else
          warn "DRIFT: Marketplace '$name' is in lock file but not used by the base settings"
        fi
        extra_count=$((extra_count + 1))
        result=1
        ;;
      unlocked)
        if [ "$item_type" = "plugin" ]; then
          warn "DRIFT: Plugin $key is enabled in the base but neither installed nor locked"
        else
          warn "DRIFT: Marketplace $name is used by the base but neither installed nor locked"
        fi
        missing_count=$((missing_count + 1))
        result=1
        ;;
      local)
        info "Local only: ${key:-$name} (not tracked in the lock file)"
        ;;
    esac
  done <<EOF
$plan
EOF

  if [ "$result" -eq 0 ]; then
    info "OK: $item_type_cap lock file is up to date"
  else
    printf "\n"
    section "$item_type_cap Lock File Drift Summary"
    indent printf "Missing in lock: %d\n" "$missing_count"
    indent printf "Extra in lock:   %d\n" "$extra_count"
    printf "\n"
    indent printf "Run 'claude-plugins install' to fix drift.\n"
  fi

  return "$result"
}

verify_marketplaces() {
  section "Verifying marketplaces"

  local lock_file="$_MARKETPLACES_LOCK_FILE_PATH"
  local marketplaces_dir="$_MARKETPLACES_DIR_PATH"

  if [ ! -f "$lock_file" ]; then
    warn "Marketplaces lock file not found: $lock_file" >&2
    warn "Note: this file should be tracked in your dotfiles." >&2
    return 1
  fi

  if [ ! -d "$marketplaces_dir" ]; then
    warn "Marketplaces directory not found: $marketplaces_dir" >&2
    warn "Run 'claude-plugins update' to install marketplaces" >&2
    return 0
  fi

  local marketplace_missing_count=0
  local marketplace_match_count=0
  local marketplace_mismatch_count=0
  local marketplace_local_count=0
  local exit_code=0

  local expected_marketplaces
  expected_marketplaces=$(jq -r 'keys[]' "$lock_file")

  for marketplace_name in $expected_marketplaces; do
    local marketplace_dir="$marketplaces_dir/$marketplace_name"
    local repo
    local expected_commit

    repo=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].repo' \
        "$lock_file"
    )
    expected_commit=$(
      jq -r \
        --arg name "$marketplace_name" \
        '.[$name].commit // "unknown"' \
        "$lock_file"
    )

    if [ ! -d "$marketplace_dir" ]; then
      warn "Missing: $marketplace_name (from $repo)"
      if [ "$expected_commit" != "unknown" ] \
        && [ "$expected_commit" != "null" ]; then
        warn "  Expected @ $expected_commit"
      fi
      marketplace_missing_count=$((marketplace_missing_count + 1))
      exit_code=1
      continue
    fi

    local actual_commit
    actual_commit=$(get_marketplace_commit "$marketplace_dir")

    if [ "$expected_commit" != "unknown" ] \
      && [ "$expected_commit" != "null" ]; then

      if [ "$actual_commit" = "$expected_commit" ]; then
        info "Ok: $marketplace_name @ $actual_commit"
        marketplace_match_count=$((marketplace_match_count + 1))
      else
        warn "Mismatch: $marketplace_name"
        warn "  Expected: $expected_commit"
        warn "  Actual:   $actual_commit"
        marketplace_mismatch_count=$((marketplace_mismatch_count + 1))
        exit_code=1
      fi
    else
      info "Ok: $marketplace_name @ $actual_commit (no expected commit in lock file)"
      marketplace_match_count=$((marketplace_match_count + 1))
    fi
  done

  for marketplace_dir in "$marketplaces_dir"/*; do
    if [ ! -d "$marketplace_dir" ]; then
      continue
    fi

    local marketplace_name
    local is_expected
    marketplace_name="$(basename "$marketplace_dir")"
    is_expected=$(
      jq -r \
        --arg name "$marketplace_name" \
        'has($name)' \
        "$lock_file"
    )

    if [ "$is_expected" = "false" ]; then
      info "Local: $marketplace_name (installed here, not in lock file)"
      marketplace_local_count=$((marketplace_local_count + 1))
    fi
  done

  printf "\n"
  section "Marketplaces Summary"
  indent printf "Matching: %d\n" "$marketplace_match_count"
  indent printf "Missing:  %d\n" "$marketplace_missing_count"
  indent printf "Mismatch: %d\n" "$marketplace_mismatch_count"
  indent printf "Local:    %d\n" "$marketplace_local_count"

  if [ "$exit_code" -eq 0 ]; then
    printf "\n"
    indent printf "All marketplaces match expected versions.\n"
  else
    printf "\n"
    indent printf "Some marketplaces need attention.\n"
    indent printf "Run 'claude-plugins update' to fix.\n"
  fi

  return "$exit_code"
}

verify_marketplace_lock_file() {
  verify_lock_file_drift \
    "marketplace" \
    "marketplaces" \
    "$_MARKETPLACES_LOCK_FILE_PATH" \
    plan_marketplace_lock_changes
}

verify_plugins() {
  section "Verifying plugin versions"

  local lock_file="$_PLUGINS_LOCK_FILE_PATH"
  local marketplaces_lock_file="$_MARKETPLACES_LOCK_FILE_PATH"
  local cache_dir="$_CACHE_DIR_PATH"
  local installed_plugins_file="$_INSTALLED_PLUGINS_FILE_PATH"

  if [ ! -f "$lock_file" ]; then
    warn "Plugins lock file not found: $lock_file" >&2
    warn "Run 'claude-plugins update' first to create it." >&2
    return 1
  fi

  if [ ! -d "$cache_dir" ]; then
    warn "Plugin cache directory not found: $cache_dir" >&2
    warn "Plugins will be downloaded on first Claude Code run." >&2
    return 0
  fi

  local plugin_missing_count=0
  local plugin_mismatch_count=0
  local plugin_extra_count=0
  local plugin_match_count=0
  local exit_code=0

  local expected_plugins
  expected_plugins=$(jq -r 'keys[]' "$lock_file")

  for plugin_name in $expected_plugins; do
    local expected_commit
    local marketplace_name
    local plugin_dir
    local actual_commit="unknown"

    expected_commit="$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].commit' \
        "$lock_file"
    )"
    marketplace_name="$(
      jq -r \
        --arg name "$plugin_name" \
        '.[$name].marketplace' \
        "$lock_file"
    )"

    # Look up actual install path and commit from installed_plugins.json
    if [ -f "$installed_plugins_file" ]; then
      local plugin_key="${plugin_name}@${marketplace_name}"
      local install_path

      install_path="$(
        jq -r \
          --arg key "$plugin_key" \
          '.plugins[$key][0].installPath // empty' \
          "$installed_plugins_file"
      )"

      if [ -n "$install_path" ]; then
        plugin_dir="$install_path"
        actual_commit="$(installed_plugin_commit "$plugin_key")"
      else
        # Fall back to cache directory if not in installed_plugins.json
        plugin_dir="$cache_dir/$plugin_name"
      fi
    else
      # Fall back to cache directory if installed_plugins.json doesn't exist
      plugin_dir="$cache_dir/$plugin_name"
    fi

    if [ ! -d "$plugin_dir" ]; then
      warn "Missing: $plugin_name (expected @ $expected_commit)"
      plugin_missing_count=$((plugin_missing_count + 1))
      exit_code=1
      continue
    fi

    # If we haven't gotten the commit yet, try from git directly
    if [ "$actual_commit" = "unknown" ]; then
      actual_commit="$(get_git_commit "$plugin_dir")"
    fi

    if [ "$actual_commit" = "$expected_commit" ]; then
      info "OK: $plugin_name @ $actual_commit"
      plugin_match_count=$((plugin_match_count + 1))
    else
      warn "Mismatch: $plugin_name"
      warn "  Expected: $expected_commit"
      warn "  Actual:   $actual_commit"
      plugin_mismatch_count=$((plugin_mismatch_count + 1))
      exit_code=1
    fi
  done

  for plugin_dir in "$cache_dir"/*; do
    if [ ! -d "$plugin_dir" ]; then
      continue
    fi

    local plugin_name
    local is_marketplace
    local is_expected
    plugin_name="$(basename "$plugin_dir")"

    # Skip if this is a marketplace directory (locked or installed here)
    is_marketplace="false"
    local marketplaces_file
    for marketplaces_file in \
      "$marketplaces_lock_file" "$_KNOWN_MARKETPLACES_FILE_PATH"; do
      if [ -f "$marketplaces_file" ] \
        && jq -e --arg name "$plugin_name" 'has($name)' \
          "$marketplaces_file" >/dev/null 2>&1; then
        is_marketplace="true"
      fi
    done
    if [ "$is_marketplace" = "true" ]; then
      continue
    fi

    is_expected="$(
      jq -r \
        --arg name "$plugin_name" \
        'has($name)' \
        "$lock_file"
    )"

    if [ "$is_expected" = "false" ]; then
      info "Extra: $plugin_name (not in lock file)"
      plugin_extra_count=$((plugin_extra_count + 1))
    fi
  done

  printf "\n"
  section "Plugin Versions Summary"
  indent printf "Matching: %d\n" "$plugin_match_count"
  indent printf "Missing:  %d\n" "$plugin_missing_count"
  indent printf "Mismatch: %d\n" "$plugin_mismatch_count"
  indent printf "Extra:    %d\n" "$plugin_extra_count"

  if [ "$exit_code" -eq 0 ]; then
    printf "\n"
    indent printf "All plugins match expected versions.\n"
  else
    printf "\n"
    indent printf "Some plugins need attention.\n"
  fi

  return "$exit_code"
}

verify_plugin_lock_file() {
  verify_lock_file_drift \
    "plugin" \
    "plugins" \
    "$_PLUGINS_LOCK_FILE_PATH" \
    plan_plugin_lock_changes
}

verify_settings_render() {
  section "Checking settings rendering"

  local settings="$_SETTINGS_FILE_PATH"
  local base_settings="$_BASE_SETTINGS_FILE_PATH"
  local local_settings_overlay="$_LOCAL_SETTINGS_OVERLAY_FILE_PATH"

  if [ ! -f "$base_settings" ]; then
    warn "Base settings file not found: $base_settings" >&2
    return 1
  fi

  local overlay="$local_settings_overlay"
  if [ ! -f "$overlay" ]; then
    overlay=$(mktemp_file)
    cleanup_file "$overlay"
    jq -n '{enabledPlugins: {}, extraKnownMarketplaces: {}}' >"$overlay"
  fi

  if [ ! -f "$settings" ]; then
    warn "MISSING: $settings has not been rendered yet" >&2
    warn "Run 'claude-plugins render' or 'claude-plugins install' to fix." >&2
    return 1
  fi

  local expected actual
  expected="$(render_settings_json "$base_settings" "$overlay")"
  actual="$(jq --sort-keys . "$settings")"

  if [ "$actual" = "$expected" ]; then
    info "OK: settings file matches base + local overlay"
    return 0
  else
    warn "DRIFT: settings file differs from what base + local overlay would render"
    warn "(Expected if you toggled plugins in Claude Code and haven't"
    warn "run 'claude-plugins capture' yet.)"
    return 1
  fi
}

