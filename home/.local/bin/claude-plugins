#!/usr/bin/env sh
# shellcheck disable=SC3043
set -eu

print_usage() {
  cat <<-EOF
	claude-plugins - Manage Claude Code plugin marketplaces and installations
	
	USAGE:
	    claude-plugins <SUBCOMMAND>
	
	SUBCOMMANDS:
	    install    Sync installed marketplaces and plugins to exact lock file versions
	    update     Install/update marketplaces and capture current plugin versions
	    verify     Verify installed marketplaces and plugins match lock file versions
	    help       Print this help message
	
	EOF
}

main() {
  MARKETPLACES_DIR="${HOME}/.claude/plugins/marketplaces"
  MARKETPLACES_LOCK_FILE="${HOME}/.claude/plugins/.marketplaces.lock.json"
  CACHE_DIR="${HOME}/.claude/plugins/cache"
  PLUGINS_LOCK_FILE="${HOME}/.claude/plugins/.plugins.lock.json"
  KNOWN_MARKETPLACES_FILE="${HOME}/.claude/plugins/known_marketplaces.json"
  INSTALLED_PLUGINS_FILE="${HOME}/.claude/plugins/installed_plugins.json"

  need_cmd jq
  need_cmd git
  need_cmd claude

  case "${1:-}" in
    install)
      cmd_install
      ;;
    update)
      cmd_update
      ;;
    verify)
      cmd_verify
      ;;
    help | --help | -h)
      print_usage
      exit 0
      ;;
    "")
      die "Missing subcommand. Run 'claude-plugins help' for usage."
      ;;
    *)
      die "Unknown subcommand: $1. Run 'claude-plugins help' for usage."
      ;;
  esac
}

cmd_install() {
  local exit_code=0

  # Detect and fix marketplace lock file drift
  sync_marketplace_lock_file || exit_code=1
  printf "\n"

  install_marketplaces || exit_code=1
  printf "\n"

  # Detect and fix plugin lock file drift
  sync_plugin_lock_file || exit_code=1
  printf "\n"

  install_plugins || exit_code=1

  print_summary "$exit_code" \
    "Marketplace and plugin sync completed successfully
All installations now match lock file versions." \
    "Some errors occurred during sync
Some installations may not match lock file versions."

  return "$exit_code"
}

cmd_update() {
  local exit_code=0

  update_marketplaces || exit_code=1
  printf "\n"
  update_plugin_versions || exit_code=1

  print_summary "$exit_code" \
    "Marketplace and plugin update completed successfully" \
    "Some errors occurred during update"

  return "$exit_code"
}

cmd_verify() {
  local exit_code=0

  # Detect marketplace lock file drift (but don't fix)
  verify_marketplace_lock_file || exit_code=1
  printf "\n"

  verify_marketplaces || exit_code=1
  printf "\n"

  # Detect plugin lock file drift (but don't fix)
  verify_plugin_lock_file || exit_code=1
  printf "\n"

  verify_plugins || exit_code=1

  print_summary "$exit_code" \
    "All marketplaces and plugins verified successfully" \
    "Some marketplaces or plugins need attention"

  return "$exit_code"
}

# Detects marketplace lock file drift for verify command (no fix)
verify_marketplace_lock_file() {
  print_section "CHECKING MARKETPLACE LOCK FILE DRIFT"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" "$MARKETPLACES_LOCK_FILE" >&2
    return 1
  fi

  if [ ! -f "$KNOWN_MARKETPLACES_FILE" ]; then
    printf "Warning: known_marketplaces.json not found: %s\n" "$KNOWN_MARKETPLACES_FILE" >&2
    printf "No marketplaces are currently added to Claude.\n" >&2
    return 0
  fi

  local lock_marketplaces
  local known_marketplaces
  local missing_in_lock=0
  local extra_in_lock=0
  local exit_code=0

  lock_marketplaces=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE" | sort)
  known_marketplaces=$(jq -r 'keys[]' "$KNOWN_MARKETPLACES_FILE" | sort)

  # Check for marketplaces in known_marketplaces.json but not in lock file
  for marketplace_name in $known_marketplaces; do
    local in_lock
    in_lock=$(printf "%s\n" "$lock_marketplaces" | grep -x "$marketplace_name" || printf "")

    if [ -z "$in_lock" ]; then
      printf "DRIFT: Marketplace '%s' is in Claude but not in lock file\n" "$marketplace_name"
      missing_in_lock=$((missing_in_lock + 1))
      exit_code=1
    fi
  done

  # Check for marketplaces in lock file but not in known_marketplaces.json
  for marketplace_name in $lock_marketplaces; do
    local in_known
    in_known=$(printf "%s\n" "$known_marketplaces" | grep -x "$marketplace_name" || printf "")

    if [ -z "$in_known" ]; then
      printf "DRIFT: Marketplace '%s' is in lock file but not in Claude\n" "$marketplace_name"
      extra_in_lock=$((extra_in_lock + 1))
      exit_code=1
    fi
  done

  if [ "$exit_code" -eq 0 ]; then
    printf "OK: Marketplace lock file is up to date\n"
  else
    printf "\n--- Marketplace Lock File Drift Summary ---\n"
    printf "Missing in lock: %d\n" "$missing_in_lock"
    printf "Extra in lock:   %d\n" "$extra_in_lock"
    printf "\nRun 'claude-plugins install' to fix drift.\n"
  fi

  return "$exit_code"
}

# Detects and fixes marketplace lock file drift for install command
sync_marketplace_lock_file() {
  print_section "SYNCING MARKETPLACE LOCK FILE"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" "$MARKETPLACES_LOCK_FILE" >&2
    return 1
  fi

  if [ ! -f "$KNOWN_MARKETPLACES_FILE" ]; then
    printf "Warning: known_marketplaces.json not found: %s\n" "$KNOWN_MARKETPLACES_FILE" >&2
    printf "No marketplaces are currently added to Claude.\n" >&2
    return 0
  fi

  local lock_marketplaces
  local known_marketplaces
  local added_count=0
  local removed_count=0
  local exit_code=0
  local needs_update=0

  lock_marketplaces=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE" | sort)
  known_marketplaces=$(jq -r 'keys[]' "$KNOWN_MARKETPLACES_FILE" | sort)

  # Check for marketplaces in known_marketplaces.json but not in lock file
  for marketplace_name in $known_marketplaces; do
    local in_lock
    in_lock=$(printf "%s\n" "$lock_marketplaces" | grep -x "$marketplace_name" || printf "")

    if [ -z "$in_lock" ]; then
      printf "Adding to lock file: %s\n" "$marketplace_name"

      # Get marketplace info from known_marketplaces.json
      local source_obj
      local source_type
      local repo
      source_obj=$(jq -r --arg name "$marketplace_name" '.[$name].source' "$KNOWN_MARKETPLACES_FILE")
      source_type=$(printf "%s" "$source_obj" | jq -r '.source // "unknown"')
      repo=$(printf "%s" "$source_obj" | jq -r '.repo // "unknown"')

      # Get current commit from marketplace directory
      local marketplace_dir
      local commit="unknown"
      marketplace_dir=$(jq -r --arg name "$marketplace_name" '.[$name].installLocation' "$KNOWN_MARKETPLACES_FILE")

      if [ -n "$marketplace_dir" ] && [ -d "$marketplace_dir/.git" ]; then
        cd "$marketplace_dir"
        commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")
        cd - >/dev/null 2>&1
        printf "  @ %s\n" "$commit"
      fi

      local updated
      updated=$(date -u +%Y-%m-%d)

      # Add to lock file
      local entry
      entry=$(jq -n \
        --arg source "$source_type" \
        --arg repo "$repo" \
        --arg commit "$commit" \
        --arg updated "$updated" \
        '{source: $source, repo: $repo, commit: $commit, updated: $updated}')

      jq --arg name "$marketplace_name" --argjson entry "$entry" \
        '. + {($name): $entry}' "$MARKETPLACES_LOCK_FILE" >"$MARKETPLACES_LOCK_FILE.tmp"
      cat "$MARKETPLACES_LOCK_FILE.tmp" >"$MARKETPLACES_LOCK_FILE" && rm "$MARKETPLACES_LOCK_FILE.tmp"

      added_count=$((added_count + 1))
      needs_update=1
    fi
  done

  # Check for marketplaces in lock file but not in known_marketplaces.json
  for marketplace_name in $lock_marketplaces; do
    local in_known
    in_known=$(printf "%s\n" "$known_marketplaces" | grep -x "$marketplace_name" || printf "")

    if [ -z "$in_known" ]; then
      printf "Removing from lock file: %s\n" "$marketplace_name"

      # Remove from lock file
      jq --arg name "$marketplace_name" 'del(.[$name])' "$MARKETPLACES_LOCK_FILE" >"$MARKETPLACES_LOCK_FILE.tmp"
      cat "$MARKETPLACES_LOCK_FILE.tmp" >"$MARKETPLACES_LOCK_FILE" && rm "$MARKETPLACES_LOCK_FILE.tmp"

      removed_count=$((removed_count + 1))
      needs_update=1
    fi
  done

  if [ "$needs_update" -eq 0 ]; then
    printf "OK: Marketplace lock file is already up to date\n"
  else
    printf "\n--- Marketplace Lock File Sync Summary ---\n"
    printf "Added:   %d\n" "$added_count"
    printf "Removed: %d\n" "$removed_count"
    printf "\nMarketplace lock file updated!\n"
  fi

  return "$exit_code"
}

# Detects plugin lock file drift for verify command (no fix)
verify_plugin_lock_file() {
  print_section "CHECKING PLUGIN LOCK FILE DRIFT"

  if [ ! -f "$PLUGINS_LOCK_FILE" ]; then
    printf "Error: plugins lock file not found: %s\n" "$PLUGINS_LOCK_FILE" >&2
    return 1
  fi

  if [ ! -f "$INSTALLED_PLUGINS_FILE" ]; then
    printf "Warning: installed_plugins.json not found: %s\n" "$INSTALLED_PLUGINS_FILE" >&2
    printf "No plugins are currently installed in Claude.\n" >&2
    return 0
  fi

  local lock_plugins
  local installed_plugin_keys
  local missing_in_lock=0
  local extra_in_lock=0
  local exit_code=0

  lock_plugins=$(jq -r 'keys[]' "$PLUGINS_LOCK_FILE" | sort)
  installed_plugin_keys=$(jq -r '.plugins | keys[]' "$INSTALLED_PLUGINS_FILE" 2>/dev/null | sort)

  # Extract plugin names from keys (format: plugin@marketplace)
  local installed_plugins
  installed_plugins=$(printf "%s\n" "$installed_plugin_keys" | sed 's/@.*//' | sort -u)

  # Check for plugins in installed_plugins.json but not in lock file
  for plugin_name in $installed_plugins; do
    local in_lock
    in_lock=$(printf "%s\n" "$lock_plugins" | grep -x "$plugin_name" || printf "")

    if [ -z "$in_lock" ]; then
      printf "DRIFT: Plugin '%s' is in Claude but not in lock file\n" "$plugin_name"
      missing_in_lock=$((missing_in_lock + 1))
      exit_code=1
    fi
  done

  # Check for plugins in lock file but not in installed_plugins.json
  for plugin_name in $lock_plugins; do
    local in_installed
    in_installed=$(printf "%s\n" "$installed_plugins" | grep -x "$plugin_name" || printf "")

    if [ -z "$in_installed" ]; then
      printf "DRIFT: Plugin '%s' is in lock file but not in Claude\n" "$plugin_name"
      extra_in_lock=$((extra_in_lock + 1))
      exit_code=1
    fi
  done

  if [ "$exit_code" -eq 0 ]; then
    printf "OK: Plugin lock file is up to date\n"
  else
    printf "\n--- Plugin Lock File Drift Summary ---\n"
    printf "Missing in lock: %d\n" "$missing_in_lock"
    printf "Extra in lock:   %d\n" "$extra_in_lock"
    printf "\nRun 'claude-plugins install' to fix drift.\n"
  fi

  return "$exit_code"
}

# Detects and fixes plugin lock file drift for install command
sync_plugin_lock_file() {
  print_section "SYNCING PLUGIN LOCK FILE"

  if [ ! -f "$PLUGINS_LOCK_FILE" ]; then
    printf "Error: plugins lock file not found: %s\n" "$PLUGINS_LOCK_FILE" >&2
    return 1
  fi

  if [ ! -f "$INSTALLED_PLUGINS_FILE" ]; then
    printf "Warning: installed_plugins.json not found: %s\n" "$INSTALLED_PLUGINS_FILE" >&2
    printf "No plugins are currently installed in Claude.\n" >&2
    return 0
  fi

  local lock_plugins
  local installed_plugin_keys
  local added_count=0
  local removed_count=0
  local exit_code=0
  local needs_update=0

  lock_plugins=$(jq -r 'keys[]' "$PLUGINS_LOCK_FILE" | sort)
  installed_plugin_keys=$(jq -r '.plugins | keys[]' "$INSTALLED_PLUGINS_FILE" 2>/dev/null | sort)

  # Extract plugin names from keys (format: plugin@marketplace)
  local installed_plugins
  installed_plugins=$(printf "%s\n" "$installed_plugin_keys" | sed 's/@.*//' | sort -u)

  # Check for plugins in installed_plugins.json but not in lock file
  for plugin_name in $installed_plugins; do
    local in_lock
    in_lock=$(printf "%s\n" "$lock_plugins" | grep -x "$plugin_name" || printf "")

    if [ -z "$in_lock" ]; then
      printf "Adding to lock file: %s\n" "$plugin_name"

      # Find the plugin key that contains this plugin name
      local plugin_key
      plugin_key=$(printf "%s\n" "$installed_plugin_keys" | grep "^${plugin_name}@" | head -n 1)

      if [ -z "$plugin_key" ]; then
        printf "  Warning: Could not find plugin key for %s\n" "$plugin_name" >&2
        continue
      fi

      # Get plugin info from installed_plugins.json
      local install_path
      local marketplace_name
      local commit="unknown"
      local git_commit_sha

      install_path=$(jq -r --arg key "$plugin_key" '.plugins[$key].installPath' "$INSTALLED_PLUGINS_FILE")
      marketplace_name=$(printf "%s" "$plugin_key" | sed 's/.*@//')
      git_commit_sha=$(jq -r --arg key "$plugin_key" '.plugins[$key].gitCommitSha // "unknown"' "$INSTALLED_PLUGINS_FILE")

      # First try to use gitCommitSha from installed_plugins.json
      if [ "$git_commit_sha" != "unknown" ] && [ "$git_commit_sha" != "null" ]; then
        commit="$git_commit_sha"
        printf "  @ %s\n" "$commit"
      elif [ -n "$install_path" ] && [ -d "$install_path/.git" ]; then
        # Fall back to checking git repo directly
        cd "$install_path"
        commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")
        cd - >/dev/null 2>&1
        printf "  @ %s\n" "$commit"
      else
        printf "  @ %s (local plugin, no git tracking)\n" "$commit"
      fi

      local updated
      updated=$(date -u +%Y-%m-%d)

      # Add to lock file
      local entry
      entry=$(jq -n \
        --arg marketplace "$marketplace_name" \
        --arg commit "$commit" \
        --arg updated "$updated" \
        '{marketplace: $marketplace, commit: $commit, updated: $updated}')

      jq --arg name "$plugin_name" --argjson entry "$entry" \
        '. + {($name): $entry}' "$PLUGINS_LOCK_FILE" >"$PLUGINS_LOCK_FILE.tmp"
      cat "$PLUGINS_LOCK_FILE.tmp" >"$PLUGINS_LOCK_FILE" && rm "$PLUGINS_LOCK_FILE.tmp"

      added_count=$((added_count + 1))
      needs_update=1
    fi
  done

  # Check for plugins in lock file but not in installed_plugins.json
  for plugin_name in $lock_plugins; do
    local in_installed
    in_installed=$(printf "%s\n" "$installed_plugins" | grep -x "$plugin_name" || printf "")

    if [ -z "$in_installed" ]; then
      printf "Removing from lock file: %s\n" "$plugin_name"

      # Remove from lock file
      jq --arg name "$plugin_name" 'del(.[$name])' "$PLUGINS_LOCK_FILE" >"$PLUGINS_LOCK_FILE.tmp"
      cat "$PLUGINS_LOCK_FILE.tmp" >"$PLUGINS_LOCK_FILE" && rm "$PLUGINS_LOCK_FILE.tmp"

      removed_count=$((removed_count + 1))
      needs_update=1
    fi
  done

  if [ "$needs_update" -eq 0 ]; then
    printf "OK: Plugin lock file is already up to date\n"
  else
    printf "\n--- Plugin Lock File Sync Summary ---\n"
    printf "Added:   %d\n" "$added_count"
    printf "Removed: %d\n" "$removed_count"
    printf "\nPlugin lock file updated!\n"
  fi

  return "$exit_code"
}

# Syncs marketplaces to lock file versions
install_marketplaces() {
  print_section "SYNCING MARKETPLACES TO LOCK FILE"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" "$MARKETPLACES_LOCK_FILE" >&2
    printf "Run 'claude-plugins update' first to create it.\n" >&2
    return 1
  fi

  local marketplace_synced_count=0
  local marketplace_skipped_count=0
  local marketplace_names
  local exit_code=0

  marketplace_names=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE")

  for marketplace_name in $marketplace_names; do
    local source
    local repo
    local expected_commit

    source=$(jq -r --arg name "$marketplace_name" '.[$name].source' "$MARKETPLACES_LOCK_FILE")
    repo=$(jq -r --arg name "$marketplace_name" '.[$name].repo' "$MARKETPLACES_LOCK_FILE")
    expected_commit=$(jq -r --arg name "$marketplace_name" '.[$name].commit // "unknown"' "$MARKETPLACES_LOCK_FILE")

    if [ "$source" != "github" ]; then
      printf "Warning: Skipping %s - only 'github' source is supported\n" "$marketplace_name" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    if [ -z "$repo" ] || [ "$repo" = "null" ]; then
      printf "Warning: Skipping %s - no repo specified\n" "$marketplace_name" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    if [ "$expected_commit" = "unknown" ] || [ "$expected_commit" = "null" ]; then
      printf "Warning: Skipping %s - no commit specified in lock file\n" "$marketplace_name" >&2
      marketplace_skipped_count=$((marketplace_skipped_count + 1))
      continue
    fi

    # Check if marketplace is already installed
    local is_installed
    is_installed=$(jq -r --arg name "$marketplace_name" 'has($name)' "$KNOWN_MARKETPLACES_FILE" 2>/dev/null || printf "false")

    if [ "$is_installed" = "true" ]; then
      # Marketplace exists, check if it's at the right commit
      local marketplace_dir
      marketplace_dir=$(jq -r --arg name "$marketplace_name" '.[$name].installLocation' "$KNOWN_MARKETPLACES_FILE")

      if [ -d "$marketplace_dir" ]; then
        cd "$marketplace_dir"
        local actual_commit
        actual_commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")

        if [ "$actual_commit" = "$expected_commit" ]; then
          printf "Already synced: %s @ %s\n" "$marketplace_name" "$expected_commit"
          cd - >/dev/null 2>&1
          continue
        else
          printf "Syncing: %s\n" "$marketplace_name"
          printf "  From: %s\n" "$actual_commit"
          printf "  To:   %s\n" "$expected_commit"

          git fetch origin >/dev/null 2>&1 || {
            printf "  Warning: Could not fetch from origin\n" >&2
          }

          if ! git reset --hard "$expected_commit" 2>/dev/null; then
            printf "  Error: Could not reset to commit %s\n" "$expected_commit" >&2
            exit_code=1
            cd - >/dev/null 2>&1
            continue
          fi
          marketplace_synced_count=$((marketplace_synced_count + 1))
        fi
        cd - >/dev/null 2>&1
      fi
    else
      # Marketplace not installed, add it via claude CLI
      printf "Installing: %s (from %s)\n" "$marketplace_name" "$repo"

      if ! claude plugin marketplace add "$repo" >/dev/null 2>&1; then
        printf "  Error: Could not add marketplace via 'claude plugin marketplace add'\n" >&2
        exit_code=1
        continue
      fi

      # After adding, reset to the specific commit
      local marketplace_dir
      marketplace_dir=$(jq -r --arg name "$marketplace_name" '.[$name].installLocation' "$KNOWN_MARKETPLACES_FILE" 2>/dev/null)

      if [ -n "$marketplace_dir" ] && [ -d "$marketplace_dir" ]; then
        cd "$marketplace_dir"
        if ! git reset --hard "$expected_commit" 2>/dev/null; then
          printf "  Error: Could not reset to commit %s\n" "$expected_commit" >&2
          exit_code=1
          cd - >/dev/null 2>&1
          continue
        fi
        cd - >/dev/null 2>&1
        printf "  @ %s\n" "$expected_commit"
        marketplace_synced_count=$((marketplace_synced_count + 1))
      else
        printf "  Error: Could not find installed marketplace directory\n" >&2
        exit_code=1
      fi
    fi
  done

  printf "\n--- Marketplace Sync Summary ---\n"
  printf "Lock file: %s\n" "$MARKETPLACES_LOCK_FILE"
  printf "Synced:  %d\n" "$marketplace_synced_count"
  printf "Skipped: %d\n" "$marketplace_skipped_count"
  printf "\nMarketplace sync complete!\n"

  return "$exit_code"
}

# Syncs plugins to lock file versions
install_plugins() {
  print_section "SYNCING PLUGINS TO LOCK FILE"

  if [ ! -f "$PLUGINS_LOCK_FILE" ]; then
    printf "Error: plugins lock file not found: %s\n" "$PLUGINS_LOCK_FILE" >&2
    printf "Run 'claude-plugins update' first to create it.\n" >&2
    return 1
  fi

  local plugin_synced_count=0
  local plugin_skipped_count=0
  local plugin_names
  local exit_code=0

  plugin_names=$(jq -r 'keys[]' "$PLUGINS_LOCK_FILE")

  for plugin_name in $plugin_names; do
    local marketplace_name
    local expected_commit

    marketplace_name=$(jq -r --arg name "$plugin_name" '.[$name].marketplace' "$PLUGINS_LOCK_FILE")
    expected_commit=$(jq -r --arg name "$plugin_name" '.[$name].commit' "$PLUGINS_LOCK_FILE")

    if [ -z "$marketplace_name" ] || [ "$marketplace_name" = "null" ] || [ "$marketplace_name" = "unknown" ]; then
      printf "Warning: Skipping %s - no marketplace specified\n" "$plugin_name" >&2
      plugin_skipped_count=$((plugin_skipped_count + 1))
      continue
    fi

    if [ "$expected_commit" = "unknown" ] || [ "$expected_commit" = "null" ]; then
      printf "Warning: Skipping %s - no commit specified in lock file\n" "$plugin_name" >&2
      plugin_skipped_count=$((plugin_skipped_count + 1))
      continue
    fi

    # Check if plugin is already installed
    # Search by plugin name across all marketplaces (handles URL vs name mismatch)
    local installed_plugin_key
    installed_plugin_key=$(jq -r --arg name "$plugin_name" '
      .plugins | keys[] | select(startswith($name + "@"))
    ' "$INSTALLED_PLUGINS_FILE" 2>/dev/null | head -n 1)

    local is_installed
    if [ -n "$installed_plugin_key" ]; then
      is_installed="true"
    else
      is_installed="false"
    fi

    if [ "$is_installed" = "true" ]; then
      # Plugin exists, check if it's at the right commit
      local install_path
      local actual_commit
      install_path=$(jq -r --arg key "$installed_plugin_key" '.plugins[$key].installPath' "$INSTALLED_PLUGINS_FILE")

      if [ -d "$install_path" ]; then
        cd "$install_path"
        actual_commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")

        if [ "$actual_commit" = "$expected_commit" ]; then
          printf "Already synced: %s @ %s\n" "$plugin_name" "$expected_commit"
          cd - >/dev/null 2>&1
          continue
        else
          printf "Syncing: %s\n" "$plugin_name"
          printf "  From: %s\n" "$actual_commit"
          printf "  To:   %s\n" "$expected_commit"

          git fetch origin >/dev/null 2>&1 || {
            printf "  Warning: Could not fetch from origin\n" >&2
          }

          if ! git reset --hard "$expected_commit" 2>/dev/null; then
            printf "  Error: Could not reset to commit %s\n" "$expected_commit" >&2
            exit_code=1
            cd - >/dev/null 2>&1
            continue
          fi
          plugin_synced_count=$((plugin_synced_count + 1))
        fi
        cd - >/dev/null 2>&1
      fi
    else
      # Plugin not installed, install it via claude CLI
      # Construct plugin_key using marketplace_name from lock file
      local plugin_key="${plugin_name}@${marketplace_name}"
      printf "Installing: %s (from %s)\n" "$plugin_name" "$marketplace_name"

      if ! claude plugin install "$plugin_key" >/dev/null 2>&1; then
        printf "  Error: Could not install plugin via 'claude plugin install'\n" >&2
        exit_code=1
        continue
      fi

      # After installing, reset to the specific commit
      local install_path
      install_path=$(jq -r --arg key "$plugin_key" '.plugins[$key].installPath' "$INSTALLED_PLUGINS_FILE" 2>/dev/null)

      if [ -n "$install_path" ] && [ -d "$install_path" ]; then
        cd "$install_path"
        if ! git reset --hard "$expected_commit" 2>/dev/null; then
          printf "  Error: Could not reset to commit %s\n" "$expected_commit" >&2
          exit_code=1
          cd - >/dev/null 2>&1
          continue
        fi
        cd - >/dev/null 2>&1
        printf "  @ %s\n" "$expected_commit"
        plugin_synced_count=$((plugin_synced_count + 1))
      else
        printf "  Error: Could not find installed plugin directory\n" >&2
        exit_code=1
      fi
    fi
  done

  printf "\n--- Plugin Sync Summary ---\n"
  printf "Lock file: %s\n" "$PLUGINS_LOCK_FILE"
  printf "Synced:  %d\n" "$plugin_synced_count"
  printf "Skipped: %d\n" "$plugin_skipped_count"
  printf "\nPlugin sync complete!\n"

  return "$exit_code"
}

# Updates marketplaces to latest versions
update_marketplaces() {
  print_section "UPDATING MARKETPLACES"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" "$MARKETPLACES_LOCK_FILE" >&2
    return 1
  fi

  printf "{}\n" >"$MARKETPLACES_LOCK_FILE.tmp"

  local marketplace_names
  marketplace_names=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE")

  for marketplace_name in $marketplace_names; do
    local source
    local repo

    source=$(jq -r --arg name "$marketplace_name" '.[$name].source' "$MARKETPLACES_LOCK_FILE")
    repo=$(jq -r --arg name "$marketplace_name" '.[$name].repo' "$MARKETPLACES_LOCK_FILE")

    if [ "$source" != "github" ]; then
      printf "Warning: Skipping %s - only 'github' source is supported\n" "$marketplace_name" >&2
      continue
    fi

    if [ -z "$repo" ] || [ "$repo" = "null" ]; then
      printf "Warning: Skipping %s - no repo specified\n" "$marketplace_name" >&2
      continue
    fi

    # Check if marketplace is already tracked by claude CLI
    local is_known
    is_known=$(jq -r --arg name "$marketplace_name" 'has($name)' "$KNOWN_MARKETPLACES_FILE" 2>/dev/null || printf "false")

    if [ "$is_known" = "false" ]; then
      printf "Adding: %s (from %s)\n" "$marketplace_name" "$repo"
      if ! claude plugin marketplace add "$repo" >/dev/null 2>&1; then
        printf "  Warning: Could not add marketplace\n" >&2
        continue
      fi
    fi

    printf "Updating: %s\n" "$marketplace_name"
    if ! claude plugin marketplace update "$marketplace_name" >/dev/null 2>&1; then
      printf "  Warning: Could not update marketplace\n" >&2
    fi

    # Get the current commit after update
    local marketplace_dir
    local commit="unknown"
    marketplace_dir=$(jq -r --arg name "$marketplace_name" '.[$name].installLocation' "$KNOWN_MARKETPLACES_FILE" 2>/dev/null)

    if [ -n "$marketplace_dir" ] && [ -d "$marketplace_dir/.git" ]; then
      cd "$marketplace_dir"
      commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")
      cd - >/dev/null 2>&1
      printf "  @ %s\n" "$commit"
    fi

    local updated
    updated=$(date -u +%Y-%m-%d)

    local entry
    entry=$(jq -n \
      --arg source "$source" \
      --arg repo "$repo" \
      --arg commit "$commit" \
      --arg updated "$updated" \
      '{source: $source, repo: $repo, commit: $commit, updated: $updated}')

    jq --arg name "$marketplace_name" --argjson entry "$entry" \
      '. + {($name): $entry}' "$MARKETPLACES_LOCK_FILE.tmp" >"$MARKETPLACES_LOCK_FILE.tmp.new"
    mv "$MARKETPLACES_LOCK_FILE.tmp.new" "$MARKETPLACES_LOCK_FILE.tmp"
  done

  cat "$MARKETPLACES_LOCK_FILE.tmp" >"$MARKETPLACES_LOCK_FILE" && rm "$MARKETPLACES_LOCK_FILE.tmp"

  printf "\n--- Marketplace Update Summary ---\n"
  printf "Lock file: %s\n" "$MARKETPLACES_LOCK_FILE"
  printf "Total marketplaces: %s\n" "$(jq 'length' "$MARKETPLACES_LOCK_FILE")"
  printf "\nMarketplace update complete!\n"

  return 0
}

# Updates plugin versions in lock file
update_plugin_versions() {
  print_section "UPDATING PLUGIN VERSIONS"

  if [ ! -f "$INSTALLED_PLUGINS_FILE" ]; then
    printf "Warning: No plugins installed yet.\n" >&2
    printf "Skipping plugin version update.\n" >&2
    return 0
  fi

  printf "{}\n" >"$PLUGINS_LOCK_FILE.tmp"

  # Iterate through all installed plugins
  local plugin_keys
  plugin_keys=$(jq -r '.plugins | keys[]' "$INSTALLED_PLUGINS_FILE" 2>/dev/null)

  for plugin_key in $plugin_keys; do
    local install_path
    local plugin_name
    local marketplace_name
    local commit

    install_path=$(jq -r --arg key "$plugin_key" '.plugins[$key].installPath' "$INSTALLED_PLUGINS_FILE")

    # Extract plugin name and marketplace from the key (format: plugin@marketplace)
    plugin_name=$(printf "%s" "$plugin_key" | sed 's/@.*//')
    marketplace_name=$(printf "%s" "$plugin_key" | sed 's/.*@//')

    if [ ! -d "$install_path" ]; then
      printf "Warning: Skipping %s - install path not found: %s\n" "$plugin_name" "$install_path" >&2
      continue
    fi

    commit="unknown"
    if [ -d "$install_path/.git" ]; then
      cd "$install_path"
      commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")
      cd - >/dev/null 2>&1
    fi

    local updated
    updated=$(date -u +%Y-%m-%d)

    local entry
    entry=$(jq -n \
      --arg marketplace "$marketplace_name" \
      --arg commit "$commit" \
      --arg updated "$updated" \
      '{marketplace: $marketplace, commit: $commit, updated: $updated}')

    jq --arg name "$plugin_name" --argjson entry "$entry" \
      '. + {($name): $entry}' "$PLUGINS_LOCK_FILE.tmp" >"$PLUGINS_LOCK_FILE.tmp.new"
    mv "$PLUGINS_LOCK_FILE.tmp.new" "$PLUGINS_LOCK_FILE.tmp"

    printf "Captured: %s @ %s\n" "$plugin_name" "$commit"
  done

  cat "$PLUGINS_LOCK_FILE.tmp" >"$PLUGINS_LOCK_FILE" && rm "$PLUGINS_LOCK_FILE.tmp"

  printf "\n--- Plugin Versions Update Summary ---\n"
  printf "Plugin versions saved to: %s\n" "$PLUGINS_LOCK_FILE"
  printf "Total plugins: %s\n" "$(jq 'length' "$PLUGINS_LOCK_FILE")"
  printf "\nPlugin version update complete!\n"

  return 0
}

# Verifies marketplaces against lock file
verify_marketplaces() {
  print_section "VERIFYING MARKETPLACES"

  if [ ! -f "$MARKETPLACES_LOCK_FILE" ]; then
    printf "Error: marketplaces lock file not found: %s\n" "$MARKETPLACES_LOCK_FILE" >&2
    printf "This file should be tracked in your dotfiles.\n" >&2
    return 1
  fi

  if [ ! -d "$MARKETPLACES_DIR" ]; then
    printf "Warning: Marketplaces directory not found: %s\n" "$MARKETPLACES_DIR" >&2
    printf "Run 'claude-plugins update' to install marketplaces.\n" >&2
    return 0
  fi

  local marketplace_missing_count=0
  local marketplace_match_count=0
  local marketplace_mismatch_count=0
  local marketplace_extra_count=0
  local exit_code=0

  local expected_marketplaces
  expected_marketplaces=$(jq -r 'keys[]' "$MARKETPLACES_LOCK_FILE")

  for marketplace_name in $expected_marketplaces; do
    local marketplace_dir="$MARKETPLACES_DIR/$marketplace_name"
    local repo
    local expected_commit

    repo=$(jq -r --arg name "$marketplace_name" '.[$name].repo' "$MARKETPLACES_LOCK_FILE")
    expected_commit=$(jq -r --arg name "$marketplace_name" '.[$name].commit // "unknown"' "$MARKETPLACES_LOCK_FILE")

    if [ ! -d "$marketplace_dir" ]; then
      printf "MISSING: %s (from %s)\n" "$marketplace_name" "$repo"
      if [ "$expected_commit" != "unknown" ] && [ "$expected_commit" != "null" ]; then
        printf "  Expected @ %s\n" "$expected_commit"
      fi
      marketplace_missing_count=$((marketplace_missing_count + 1))
      exit_code=1
      continue
    fi

    local actual_commit="unknown"
    if [ -d "$marketplace_dir/.git" ]; then
      cd "$marketplace_dir"
      actual_commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")
      cd - >/dev/null 2>&1
    fi

    if [ "$expected_commit" != "unknown" ] && [ "$expected_commit" != "null" ]; then
      if [ "$actual_commit" = "$expected_commit" ]; then
        printf "OK: %s @ %s\n" "$marketplace_name" "$actual_commit"
        marketplace_match_count=$((marketplace_match_count + 1))
      else
        printf "MISMATCH: %s\n" "$marketplace_name"
        printf "  Expected: %s\n" "$expected_commit"
        printf "  Actual:   %s\n" "$actual_commit"
        marketplace_mismatch_count=$((marketplace_mismatch_count + 1))
        exit_code=1
      fi
    else
      printf "OK: %s @ %s (no expected commit in lock file)\n" "$marketplace_name" "$actual_commit"
      marketplace_match_count=$((marketplace_match_count + 1))
    fi
  done

  for marketplace_dir in "$MARKETPLACES_DIR"/*; do
    if [ ! -d "$marketplace_dir" ]; then
      continue
    fi

    local marketplace_name
    local is_expected
    marketplace_name=$(basename "$marketplace_dir")
    is_expected=$(jq -r --arg name "$marketplace_name" 'has($name)' "$MARKETPLACES_LOCK_FILE")

    if [ "$is_expected" = "false" ]; then
      printf "EXTRA: %s (not in lock file)\n" "$marketplace_name"
      marketplace_extra_count=$((marketplace_extra_count + 1))
    fi
  done

  printf "\n--- Marketplaces Summary ---\n"
  printf "Matching: %d\n" "$marketplace_match_count"
  printf "Missing:  %d\n" "$marketplace_missing_count"
  printf "Mismatch: %d\n" "$marketplace_mismatch_count"
  printf "Extra:    %d\n" "$marketplace_extra_count"

  if [ "$exit_code" -eq 0 ]; then
    printf "\nAll marketplaces match expected versions.\n"
  else
    printf "\nSome marketplaces need attention. Run 'claude-plugins update' to fix.\n"
  fi

  return "$exit_code"
}

# Verifies plugins against lock file
verify_plugins() {
  print_section "VERIFYING PLUGIN VERSIONS"

  if [ ! -f "$PLUGINS_LOCK_FILE" ]; then
    printf "Error: plugins lock file not found: %s\n" "$PLUGINS_LOCK_FILE" >&2
    printf "Run 'claude-plugins update' first to create it.\n" >&2
    return 1
  fi

  if [ ! -d "$CACHE_DIR" ]; then
    printf "Warning: Plugin cache directory not found: %s\n" "$CACHE_DIR" >&2
    printf "Plugins will be downloaded on first Claude Code run.\n" >&2
    return 0
  fi

  local plugin_missing_count=0
  local plugin_mismatch_count=0
  local plugin_extra_count=0
  local plugin_match_count=0
  local exit_code=0

  local expected_plugins
  expected_plugins=$(jq -r 'keys[]' "$PLUGINS_LOCK_FILE")

  for plugin_name in $expected_plugins; do
    local expected_commit
    local marketplace_name
    local plugin_dir
    local actual_commit="unknown"

    expected_commit=$(jq -r --arg name "$plugin_name" '.[$name].commit' "$PLUGINS_LOCK_FILE")
    marketplace_name=$(jq -r --arg name "$plugin_name" '.[$name].marketplace' "$PLUGINS_LOCK_FILE")

    # Look up actual install path and commit from installed_plugins.json
    if [ -f "$INSTALLED_PLUGINS_FILE" ]; then
      local plugin_key="${plugin_name}@${marketplace_name}"
      local install_path
      local git_commit_sha

      install_path=$(jq -r --arg key "$plugin_key" '.plugins[$key].installPath // empty' "$INSTALLED_PLUGINS_FILE")
      git_commit_sha=$(jq -r --arg key "$plugin_key" '.plugins[$key].gitCommitSha // "unknown"' "$INSTALLED_PLUGINS_FILE")

      if [ -n "$install_path" ]; then
        plugin_dir="$install_path"

        # First try to use gitCommitSha from installed_plugins.json
        if [ "$git_commit_sha" != "unknown" ] && [ "$git_commit_sha" != "null" ]; then
          actual_commit="$git_commit_sha"
        elif [ -d "$plugin_dir/.git" ]; then
          # Fall back to checking git repo directly
          cd "$plugin_dir"
          actual_commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")
          cd - >/dev/null 2>&1
        fi
      else
        # Fall back to cache directory if not in installed_plugins.json
        plugin_dir="$CACHE_DIR/$plugin_name"
      fi
    else
      # Fall back to cache directory if installed_plugins.json doesn't exist
      plugin_dir="$CACHE_DIR/$plugin_name"
    fi

    if [ ! -d "$plugin_dir" ]; then
      printf "MISSING: %s (expected @ %s)\n" "$plugin_name" "$expected_commit"
      plugin_missing_count=$((plugin_missing_count + 1))
      exit_code=1
      continue
    fi

    # If we haven't gotten the commit yet, try from git directly
    if [ "$actual_commit" = "unknown" ] && [ -d "$plugin_dir/.git" ]; then
      cd "$plugin_dir"
      actual_commit=$(git rev-parse HEAD 2>/dev/null || printf "unknown")
      cd - >/dev/null 2>&1
    fi

    if [ "$actual_commit" = "$expected_commit" ]; then
      printf "OK: %s @ %s\n" "$plugin_name" "$actual_commit"
      plugin_match_count=$((plugin_match_count + 1))
    else
      printf "MISMATCH: %s\n" "$plugin_name"
      printf "  Expected: %s\n" "$expected_commit"
      printf "  Actual:   %s\n" "$actual_commit"
      plugin_mismatch_count=$((plugin_mismatch_count + 1))
      exit_code=1
    fi
  done

  for plugin_dir in "$CACHE_DIR"/*; do
    if [ ! -d "$plugin_dir" ]; then
      continue
    fi

    local plugin_name
    local is_expected
    plugin_name=$(basename "$plugin_dir")
    is_expected=$(jq -r --arg name "$plugin_name" 'has($name)' "$PLUGINS_LOCK_FILE")

    if [ "$is_expected" = "false" ]; then
      printf "EXTRA: %s (not in lock file)\n" "$plugin_name"
      plugin_extra_count=$((plugin_extra_count + 1))
    fi
  done

  printf "\n--- Plugin Versions Summary ---\n"
  printf "Matching: %d\n" "$plugin_match_count"
  printf "Missing:  %d\n" "$plugin_missing_count"
  printf "Mismatch: %d\n" "$plugin_mismatch_count"
  printf "Extra:    %d\n" "$plugin_extra_count"

  if [ "$exit_code" -eq 0 ]; then
    printf "\nAll plugins match expected versions.\n"
  else
    printf "\nSome plugins need attention.\n"
  fi

  return "$exit_code"
}

die() {
  printf "Error: %s\n" "$*" >&2
  exit 1
}

need_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    die "Required command '$1' not found on PATH"
  fi
}

# Prints section header banner
# Arguments:
#   $1 - Section title
print_section() {
  printf "=============================================================================\n"
  printf "%s\n" "$1"
  printf "=============================================================================\n\n"
}

# Prints overall summary banner
# Arguments:
#   $1 - Exit code (0 for success, non-zero for errors)
#   $2 - Success message
#   $3 - Error message
print_summary() {
  local exit_code="$1"
  local success_msg="$2"
  local error_msg="$3"

  printf "\n"
  print_section ""
  if [ "$exit_code" -eq 0 ]; then
    printf "✓ %s\n" "$success_msg"
  else
    printf "✗ %s\n" "$error_msg"
  fi
  printf "=============================================================================\n"
}

main "$@"
